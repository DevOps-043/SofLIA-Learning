{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "plugins": [],
    "tsBuildInfoFile": ".next/cache/tsconfig.typecheck.app.tsbuildinfo",
    "typeRoots": ["../../node_modules/@types"],
    "types": ["react", "react-dom", "node"]
  },
  "include": [
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ]
}
