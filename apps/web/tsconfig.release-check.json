{
  "extends": "./tsconfig.typecheck.json",
  "include": [
    "src/app/api/business/progress/**/*.ts",
    "src/app/api/communities/*/posts/*/comments/**/*.ts",
    "src/app/api/communities/*/posts/*/reactions/**/*.ts",
    "src/app/api/communities/*/posts/*/stats/**/*.ts",
    "src/app/api/lia/proactive-help/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ]
}
