{
  "openapi": "3.0.3",
  "info": {
    "title": "SofLIA Learning API",
    "version": "0.1.0",
    "description": "Incremental OpenAPI contract generated from Zod schemas. New API routes should register schemas here as they adopt request validation."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local web app"
    }
  ],
  "tags": [
    {
      "name": "Operations",
      "description": "Operational health and performance endpoints."
    },
    {
      "name": "Profile",
      "description": "Authenticated user profile operations."
    },
    {
      "name": "Study Planner",
      "description": "Study planning and calendar workflows."
    }
  ],
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "nullable": true
          }
        },
        "required": [
          "error"
        ]
      },
      "HealthDependency": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "down"
            ]
          },
          "responseTimeMs": {
            "type": "number",
            "minimum": 0
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "responseTimeMs"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "down"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "$ref": "#/components/schemas/HealthDependency"
              },
              "gemini": {
                "$ref": "#/components/schemas/HealthDependency"
              },
              "observability": {
                "$ref": "#/components/schemas/HealthDependency"
              }
            },
            "required": [
              "database",
              "gemini",
              "observability"
            ]
          }
        },
        "required": [
          "status",
          "checkedAt",
          "correlationId",
          "checks"
        ]
      },
      "ProfileUpdateRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30
          },
          "first_name": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "last_name": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "display_name": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 20
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          },
          "location": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "platform_role": {
            "type": "string",
            "nullable": true
          },
          "type_rol": {
            "type": "string",
            "nullable": true
          },
          "job_title": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "job_description": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000
          },
          "profile_picture_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500,
                "format": "uri"
              },
              {
                "type": "string",
                "enum": [
                  ""
                ]
              },
              {
                "nullable": true
              }
            ]
          },
          "country_code": {
            "type": "string",
            "nullable": true,
            "maxLength": 10
          },
          "date_of_birth": {
            "type": "string",
            "nullable": true
          },
          "gender": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "nullable": true,
            "format": "email"
          },
          "username": {
            "type": "string",
            "nullable": true
          },
          "first_name": {
            "type": "string",
            "nullable": true
          },
          "last_name": {
            "type": "string",
            "nullable": true
          },
          "display_name": {
            "type": "string",
            "nullable": true
          },
          "profile_picture_url": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "PerformanceMetricsResponse": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "environment": {
            "type": "string"
          },
          "serverClientPool": {
            "type": "object",
            "properties": {}
          },
          "browserClientPool": {
            "type": "object",
            "properties": {}
          },
          "requestDeduplication": {
            "type": "object",
            "properties": {}
          },
          "memoryCache": {
            "type": "object",
            "properties": {}
          },
          "capacityBudget": {
            "type": "object",
            "properties": {}
          },
          "summary": {
            "type": "object",
            "properties": {}
          }
        },
        "required": [
          "timestamp",
          "serverClientPool",
          "browserClientPool",
          "requestDeduplication",
          "memoryCache",
          "capacityBudget",
          "summary"
        ]
      }
    },
    "parameters": {},
    "securitySchemes": {
      "SupabaseAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sb-access-token",
        "description": "Supabase-managed authenticated session cookie."
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Read application dependency health.",
        "responses": {
          "200": {
            "description": "Application is healthy or degraded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "A critical dependency is down.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/profile": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "Read the authenticated user profile.",
        "security": [
          {
            "SupabaseAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "org",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated user profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Profile"
        ],
        "summary": "Update the authenticated user profile.",
        "security": [
          {
            "SupabaseAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "org",
            "in": "query"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request payload is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/performance/metrics": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Read runtime performance counters and capacity budgets.",
        "responses": {
          "200": {
            "description": "Runtime performance metrics.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PerformanceMetricsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
