# Copy this file to .env.load-test and fill values locally.
# Do not commit .env.load-test.

# Netlify staging/deploy-preview URL, never production.
LOAD_BASE_URL=https://deploy-preview-123--your-site.netlify.app
LOAD_CONFIRM_STAGING=true

# Pick a stable run id so seed/run/report use the same folder.
LOAD_RUN_ID=launch-week-qa-001
LOAD_TARGET_VUS=700
LOAD_SEED_USERS=700
LOAD_AI_RATIO=0.05
LOAD_THINK_TIME_MS=1500
LOAD_THINK_TIME_JITTER_MS=1500
LOAD_PUBLIC_FLOW_MODE=once

# Use an isolated staging Supabase project whenever possible.
LOAD_TEST_SUPABASE_URL=https://your-project.supabase.co
LOAD_TEST_SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-or-secret-key

# Optional Netlify API snapshot support.
LOAD_NETLIFY_SITE_ID=
LOAD_NETLIFY_TOKEN=

# Optional database snapshot RPC installed by supabase/migrations/20260502190000_load_test_connection_snapshot.sql.
LOAD_DB_METRICS_RPC=load_test_connection_snapshot
LOAD_POOL_REQUIRE_SNAPSHOT=false

# Task 4.1 Postgres topology guard.
# Pooled runtime URL must use the Supavisor transaction pooler, usually port 6543.
SUPABASE_DB_URL_POOLED=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# Direct URL is for migrations/operator scripts only, usually port 5432.
SUPABASE_DB_URL_DIRECT=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres
LOAD_DB_CONNECTION_BUDGET=200

# Task 4.8 public performance gates.
PUBLIC_PERFORMANCE_BASE_URL=https://deploy-preview-123--your-site.netlify.app
PUBLIC_PERFORMANCE_COURSE_SLUG=curso-publico-staging
PUBLIC_PERFORMANCE_NEWS_SLUG=noticia-publica-staging
PUBLIC_PERFORMANCE_TTFB_BUDGET_MS=200
PUBLIC_PERFORMANCE_LIGHTHOUSE_MIN_SCORE=0.9

# Task 4.11 observability gates.
OBSERVABILITY_BASE_URL=https://deploy-preview-123--your-site.netlify.app
OBSERVABILITY_DASHBOARD_TOKEN=replace-with-observability-token
OBSERVABILITY_ALLOW_DEGRADED=false
