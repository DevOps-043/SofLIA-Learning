# Copy this file to .env.load-test and fill values locally.
# Do not commit .env.load-test.

# Netlify staging/deploy-preview URL, never production.
LOAD_BASE_URL=https://deploy-preview-123--your-site.netlify.app
LOAD_CONFIRM_STAGING=true

# Pick a stable run id so seed/run/report use the same folder.
LOAD_RUN_ID=launch-week-qa-001
LOAD_TARGET_VUS=700
LOAD_SEED_USERS=700
LOAD_AI_RATIO=0.05

# Use an isolated staging Supabase project whenever possible.
LOAD_TEST_SUPABASE_URL=https://your-project.supabase.co
LOAD_TEST_SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-or-secret-key

# Optional Netlify API snapshot support.
LOAD_NETLIFY_SITE_ID=
LOAD_NETLIFY_TOKEN=
