{
  "name": "aprende-y-aplica",
  "version": "1.0.0",
  "description": "Plataforma educativa Aprende y Aplica - Chat-Bot-LIA",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx concurrently --kill-others-on-fail -n \"FRONTEND,BACKEND\" -c \"cyan,magenta\" \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:packages": "npm run build --workspace=@aprende-y-aplica/ui && npm run build --workspace=@aprende-y-aplica/shared",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check --workspaces && tsc --noEmit"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "concurrently": "^8.2.2",
    "eslint": "8.57.0",
    "prettier": "^3.2.5",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.15"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.5.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aprende-y-aplica/chat-bot-lia.git"
  },
  "keywords": [
    "educacion",
    "ia",
    "chatbot",
    "nextjs",
    "express",
    "typescript"
  ],
  "author": "Equipo Aprende y Aplica",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@rrweb/types": "^2.0.0-alpha.18",
    "@types/leaflet": "^1.9.21",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "motion": "^12.23.26",
    "next-pwa": "^5.6.0",
    "openai": "^6.8.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-joyride": "^2.9.3",
    "react-leaflet": "^5.0.0",
    "react-qr-code": "^2.0.18",
    "recharts": "^3.5.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "rrweb": "^2.0.0-alpha.18",
    "rrweb-player": "^1.0.0-alpha.4",
    "zod": "^3.25.76"
  }
}
