Paths\":\"No hay asignaciones individuales de rutas de aprendizaje registradas.\",\"untitledPath\":\"Ruta sin titulo\",\"noDescription\":\"Sin descripcion\",\"workshopsCount\":\"{{count}} talleres\",\"assignedOn\":\"Asignado {{date}}\",\"revokePath\":\"Revocar ruta\",\"pathCatalogTitle\":\"Cat\\xe1logo de rutas de aprendizaje\",\"pathCatalogSubtitle\":\"Asigna rutas completas manteniendo el orden secuencial de talleres.\",\"pathSearchPlaceholder\":\"Busca por t\\xedtulo o descripci\\xf3n...\",\"noLearningPathsFound\":\"No se encontraron rutas de aprendizaje\",\"sequentialPath\":\"Ruta secuencial\",\"workshopsInSequence\":\"{{count}} talleres en secuencia\",\"alreadyAssigned\":\"Ya asignado\",\"processing\":\"Procesando...\",\"assignPath\":\"Asignar ruta\",\"assignPathTitle\":\"Asignar ruta de aprendizaje\",\"assignPathSubtitle\":\"Entrega una ruta completa respetando el orden de desbloqueo.\",\"selectMember\":\"Seleccionar miembro\",\"memberPlaceholder\":\"Buscar miembro...\",\"selectLearningPath\":\"Seleccionar ruta de aprendizaje\",\"pathPlaceholder\":\"Buscar ruta de aprendizaje...\",\"assigning\":\"Asignando...\",\"confirmAssignment\":\"Confirmar asignaci\\xf3n\",\"cancel\":\"Cancelar\",\"noOrgCourses\":\"No hay cursos adquiridos para toda la organizaci\\xf3n. Abre el cat\\xe1logo para empezar.\",\"noUserAssignments\":\"No hay asignaciones individuales registradas.\",\"confirmRevokeOrg\":\"\\xbfRevocar el acceso a este curso para TODA la organizaci\\xf3n?\",\"confirmRevokeUser\":\"\\xbfRevocar esta asignaci\\xf3n individual?\"},\"aiSettings\":{\"title\":\"Modelos de IA\",\"subtitle\":\"Configura el proveedor, el modelo, el l\\xedmite de tokens, la temperatura y el nivel de razonamiento de cada uso de IA de la plataforma. Escribe el nombre del modelo (por ejemplo gemini-3.5-flash o gpt-5.1) y la plataforma detecta el proveedor autom\\xe1ticamente.\",\"propagationNotice\":\"Los cambios se aplican sin necesidad de redesplegar. Pueden tardar hasta un minuto en propagarse a todas las instancias del servidor.\",\"loadError\":\"No se pudo cargar la configuraci\\xf3n de modelos de IA.\",\"groups\":{\"soflia\":\"SofLIA (asistente general)\",\"courses\":\"SofLIA en cursos y actividades\",\"analytics\":\"Anal\\xedtica e informes\",\"content\":\"Contenido y traducci\\xf3n\",\"platform\":\"Plataforma\"},\"fields\":{\"model\":\"Modelo\",\"maxOutputTokens\":\"M\\xe1ximo de tokens de salida\",\"temperature\":\"Temperatura\",\"thinkingLevel\":\"Nivel de razonamiento\",\"inheritedPlaceholder\":\"Heredado\",\"provider\":\"Proveedor\"},\"thinkingLevels\":{\"default\":\"Por defecto del proveedor\",\"off\":\"Desactivado\",\"low\":\"Bajo\",\"medium\":\"Medio\",\"high\":\"Alto\",\"dynamic\":\"Din\\xe1mico\"},\"source\":{\"database\":\"Configurado\",\"environment\":\"Heredado del entorno\",\"default\":\"Valor por defecto\"},\"actions\":{\"save\":\"Guardar\",\"saving\":\"Guardando...\",\"reset\":\"Restablecer\"},\"feedback\":{\"saved\":\"Configuraci\\xf3n actualizada.\",\"saveError\":\"No se pudo guardar la configuraci\\xf3n.\",\"reset\":\"Se restablecio el valor heredado.\",\"resetError\":\"No se pudo restablecer la configuraci\\xf3n.\"},\"purposes\":{\"liaGeneral\":{\"label\":\"SofLIA general\",\"description\":\"Chat principal de SofLIA en dashboard, lecci\\xf3nes y planificador.\"},\"liaIntent\":{\"label\":\"Detecci\\xf3n de intenci\\xf3n\",\"description\":\"Clasifica lo que pide el usuario antes de responder.\"},\"liaDictation\":{\"label\":\"Dictado por voz\",\"description\":\"Transcribe el audio que el usuario dicta a SofLIA.\"},\"liaLessonSuggestions\":{\"label\":\"Sugerencias de lecci\\xf3n\",\"description\":\"Genera preguntas sugeridas dentro de una lecci\\xf3n.\"},\"dialogueTutor\":{\"label\":\"Tutor de actividades\",\"description\":\"Mensajes que SofLIA muestra al estudiante durante una actividad conversacional.\"},\"dialogueEvaluator\":{\"label\":\"Evaluador de actividades\",\"description\":\"Eval\\xfaa las respuestas del estudiante contra la r\\xfabrica. Un presupuesto de tokens bajo trunca el JSON y hace fallar la actividad.\"},\"activityValidation\":{\"label\":\"Validaci\\xf3n de actividades\",\"description\":\"Revisa las entregas de actividades y genera retroalimentaci\\xf3n.\"},\"lessonAutoNote\":{\"label\":\"Notas autom\\xe1ticas de lecci\\xf3n\",\"description\":\"Genera el apunte autom\\xe1tico y el t\\xedtulo de las notas de una lecci\\xf3n.\"},\"courseCompendium\":{\"label\":\"Compendio de curso\",\"description\":\"Sintetiza el contenido completo de un curso en un documento.\"},\"courseTimeEstimation\":{\"label\":\"Estimaci\\xf3n de duraci\\xf3n\",\"description\":\"Revisa las duraci\\xf3nes estimadas de lecci\\xf3nes y m\\xf3dulos.\"},\"reportsInsights\":{\"label\":\"Insights de informes\",\"description\":\"Conclusiones de IA en el panel de informes de la organizaci\\xf3n.\"},\"reportsBlueprint\":{\"label\":\"Estructura de informes\",\"description\":\"Dise\\xf1a la estructura de los informes exportables.\"},\"businessUserAnalytics\":{\"label\":\"Anal\\xedtica del empleado\",\"description\":\"Insights personales en la anal\\xedtica de cada empleado.\"},\"learningPreview\":{\"label\":\"Vista previa de cursos y rutas\",\"description\":\"Descripciones generadas para cursos y rutas de aprendizaje.\"},\"notebookEnrichment\":{\"label\":\"Enriquecimiento del cuaderno\",\"description\":\"Resume notas, extrae conceptos clave y detecta tareas.\"},\"autoTranslation\":{\"label\":\"Traducci\\xf3n autom\\xe1tica\",\"description\":\"Traduce contenido entre espa\\xf1ol, ingl\\xe9s y portugu\\xe9s.\"},\"languageDetection\":{\"label\":\"Detecci\\xf3n de idioma\",\"description\":\"Identifica el idioma de un texto.\"},\"videoProcessing\":{\"label\":\"Procesamiento de v\\xeddeo\",\"description\":\"Transcribe y analiza los v\\xeddeos subidos por administradores.\"},\"moderation\":{\"label\":\"Moderaci\\xf3n de contenido\",\"description\":\"Analiza el contenido publicado en busca de material inapropiado.\"},\"structuredFallback\":{\"label\":\"Generaci\\xf3n estructurada (respaldo)\",\"description\":\"Modelo usado por generaciones con esquema JSON que no declaran un prop\\xf3sito propio.\"},\"quizFeedback\":{\"label\":\"Retroalimentaci\\xf3n de quiz\",\"description\":\"Explica al alumno sus respuestas tras completar un cuestionario.\"},\"notebookAssistant\":{\"label\":\"Asistente del cuaderno\",\"description\":\"Responde y reescribe apuntes dentro del editor del cuaderno.\"},\"userForensics\":{\"label\":\"An\\xe1lisis forense de usuario\",\"description\":\"Resume la auditor\\xeda de actividad de un usuario para el superadministrador.\"}},\"providers\":{\"auto\":\"Detectar autom\\xe1ticamente\",\"google\":\"Google Gemini\",\"openai\":\"OpenAI\"},\"provider\":{\"detectedHint\":\"Se enviar\\xe1 a {{provider}}.\",\"unknownHint\":\"No se reconoce este modelo. Elige el proveedor manualmente para poder guardar.\",\"lockedHint\":\"Este uso env\\xeda audio o v\\xeddeo y hoy solo lo admite Google Gemini.\"}}}'),v=JSON.parse('{\"actions\":{\"next\":\"Siguiente\",\"back\":\"Atr\\xe1s\",\"skip\":\"Omitir tour\",\"finish\":\"\\xa1Entendido!\",\"restart\":\"Ver tour guiado\",\"startTour\":\"Iniciar tour\"},\"progress\":\"{{current}}/{{total}}\",\"guideLabel\":\"Gu\\xeda interactiva\",\"courseLearn\":{\"welcome\":{\"title\":\"Aprende con claridad\",\"content\":\"Esta p\\xe1gina re\\xfane todo lo que necesitas para avanzar en la lecci\\xf3n: video, actividades, preguntas y apoyo de SofLIA.\"},\"header\":{\"title\":\"Encabezado del curso\",\"content\":\"Aqu\\xed ves el nombre del curso, puedes volver a la pantalla anterior y reiniciar este tour cuando lo necesites.\"},\"progress\":{\"title\":\"Tu avance\",\"content\":\"Este indicador resume tu progreso dentro del curso para que sepas cu\\xe1nto has completado.\"},\"sidebar\":{\"title\":\"Contenido del curso\",\"content\":\"El panel se divide en Contenido y Mis notas. En Contenido puedes recorrer los m\\xf3dulos, abrir lecciones y consultar sus actividades o materiales sin salir del curso.\"},\"moduleProgress\":{\"title\":\"Avance del m\\xf3dulo\",\"content\":\"Estas etiquetas muestran cu\\xe1ntas lecciones del m\\xf3dulo completaste y el porcentaje alcanzado.\"},\"currentLesson\":{\"title\":\"Lecci\\xf3n actual\",\"content\":\"La lecci\\xf3n resaltada marca d\\xf3nde est\\xe1s. Puedes cambiar de tema desde la lista cuando quieras continuar en otro punto.\"},\"notes\":{\"title\":\"Tus notas, siempre a la mano\",\"content\":\"Mis notas re\\xfane los apuntes que guardaste en este curso. El contador muestra cu\\xe1ntos tienes y, desde esta pesta\\xf1a, puedes crear, abrir, editar o eliminar notas y continuar en tu Libro de apuntes.\"},\"tabs\":{\"title\":\"Modos de trabajo\",\"content\":\"Cambia entre video, actividades y preguntas seg\\xfan lo que quieras hacer en este momento.\"},\"video\":{\"title\":\"Video de la lecci\\xf3n\",\"content\":\"Reproduce el contenido principal, controla el avance y usa la navegaci\\xf3n integrada para moverte entre lecciones.\"},\"resources\":{\"title\":\"Transcripci\\xf3n y resumen\",\"content\":\"Consulta el texto completo o el resumen de la lecci\\xf3n y convi\\xe9rtelos en notas para estudiar despu\\xe9s.\"},\"activitiesTab\":{\"title\":\"Actividades\",\"content\":\"Entra aqu\\xed para practicar lo aprendido, revisar materiales y completar ejercicios cuando est\\xe9n disponibles.\"},\"activities\":{\"title\":\"Pr\\xe1ctica guiada\",\"content\":\"Esta secci\\xf3n muestra actividades y materiales de apoyo de la lecci\\xf3n. Si a\\xfan no hay contenido, ver\\xe1s el estado correspondiente.\"},\"questionsTab\":{\"title\":\"Preguntas\",\"content\":\"Abre este espacio para revisar dudas del curso o iniciar una conversaci\\xf3n con otros participantes.\"},\"questions\":{\"title\":\"Conversaciones del curso\",\"content\":\"Busca preguntas existentes o crea una nueva para resolver dudas de la lecci\\xf3n.\"},\"sofliaPanel\":{\"title\":\"Panel SofLIA\",\"content\":\"Cuando SofLIA est\\xe1 abierto, aqu\\xed aparecen sugerencias, respuestas y el campo para preguntar sobre la lecci\\xf3n.\"},\"soflia\":{\"title\":\"Tu asistente SofLIA\",\"content\":\"SofLIA te ayuda a aclarar conceptos, generar notas y conectar el contenido con tu avance en el curso.\"}},\"businessUserDashboard\":{\"welcome\":{\"title\":\"Bienvenido a tu panel\",\"content\":\"Aqu\\xed encuentras tus rutas, cursos asignados y accesos principales para avanzar en tu aprendizaje.\"},\"topNav\":{\"title\":\"Barra superior\",\"content\":\"Esta zona confirma la organizaci\\xf3n activa y re\\xfane tus accesos r\\xe1pidos del panel.\"},\"notifications\":{\"title\":\"Notificaciones\",\"content\":\"Revisa avisos sobre cursos, actividades y cambios importantes para no perder seguimiento.\"},\"accountMenu\":{\"title\":\"Tu cuenta\",\"content\":\"Desde aqu\\xed puedes abrir tu perfil, estad\\xedsticas, certificados, idioma y otras opciones personales.\"},\"hero\":{\"title\":\"Resumen del panel\",\"content\":\"El saludo te ubica en tu espacio de aprendizaje y resume el objetivo de esta vista.\"},\"coursesHeader\":{\"title\":\"Tus cursos\",\"content\":\"Este bloque re\\xfane rutas de aprendizaje y cursos independientes asignados a tu cuenta.\"},\"viewToggle\":{\"title\":\"Vista de cursos\",\"content\":\"Cambia entre cuadr\\xedcula y lista para revisar tus cursos de la forma que te resulte m\\xe1s c\\xf3moda.\"},\"learningPath\":{\"title\":\"Ruta de aprendizaje\",\"content\":\"Las rutas ordenan cursos por prioridad. Completa cada paso para desbloquear o continuar el siguiente.\"},\"introVideo\":{\"title\":\"Video introductorio\",\"content\":\"Reproduce este video para entender el prop\\xf3sito de la ruta antes de empezar o continuar.\"},\"courseRail\":{\"title\":\"Carrusel de cursos\",\"content\":\"Despl\\xe1zate por la ruta para ver cursos disponibles, bloqueados y completados en orden.\"},\"courseCard\":{\"title\":\"Tarjeta de curso\",\"content\":\"Cada tarjeta muestra portada, avance, estado y acceso al contenido del curso.\"},\"certificates\":{\"title\":\"Certificados\",\"content\":\"Cuando completas un curso con certificado, este acceso te permite abrirlo r\\xe1pidamente.\"},\"standalone\":{\"title\":\"Cursos independientes\",\"content\":\"Aqu\\xed aparecen cursos asignados fuera de una ruta, con su propio progreso y estado.\"},\"soflia\":{\"title\":\"Tu asistente SofLIA\",\"content\":\"SofLIA puede ayudarte con dudas sobre tus cursos, progreso o pr\\xf3ximos pasos cuando lo necesites.\"}},\"businessPanelDashboard\":{\"welcome\":{\"title\":\"Panel empresarial\",\"content\":\"Este panel re\\xfane el estado general de tu organizaci\\xf3n, los accesos clave y la actividad reciente de tu equipo.\"},\"topNav\":{\"title\":\"Barra superior\",\"content\":\"Aqu\\xed confirmas la organizaci\\xf3n activa y encuentras accesos r\\xe1pidos a notificaciones y cuenta.\"},\"notifications\":{\"title\":\"Notificaciones\",\"content\":\"Revisa avisos importantes sobre usuarios, cursos y eventos de seguimiento de tu organizaci\\xf3n.\"},\"accountMenu\":{\"title\":\"Men\\xfa de cuenta\",\"content\":\"Desde tu avatar puedes cambiar de panel, editar perfil, ajustar idioma, revisar certificados o cerrar sesi\\xf3n.\"},\"sidebar\":{\"title\":\"Navegaci\\xf3n lateral\",\"content\":\"Usa este men\\xfa para moverte entre usuarios, cursos, rutas, estructura, reportes, revisiones y configuraci\\xf3n.\"},\"sidebarCollapse\":{\"title\":\"Ajusta el men\\xfa\",\"content\":\"Contrae o expande la barra lateral para ganar espacio de trabajo sin perder la navegaci\\xf3n principal.\"},\"hero\":{\"title\":\"Resumen inicial\",\"content\":\"El encabezado te da contexto del panel, saluda al administrador y muestra la fecha de trabajo.\"},\"relaunch\":{\"title\":\"Tour guiado\",\"content\":\"Usa este bot\\xf3n para volver a lanzar el recorrido del panel cuando necesites ubicar sus funciones principales.\"},\"stats\":{\"title\":\"M\\xe9tricas generales\",\"content\":\"Estas tarjetas muestran usuarios activos, cursos asignados, completados, progreso, certificados, engagement e invitaciones.\"},\"recentActivity\":{\"title\":\"Actividad reciente\",\"content\":\"Consulta los \\xfaltimos movimientos de tu equipo para detectar avances, cambios o pendientes relevantes.\"},\"soflia\":{\"title\":\"Tu asistente SofLIA\",\"content\":\"SofLIA puede apoyarte con dudas del panel, cursos, progreso del equipo o pr\\xf3ximos pasos de gesti\\xf3n.\"}},\"businessPanelUsers\":{\"hero\":{\"title\":\"Gesti\\xf3n de usuarios\",\"content\":\"Desde aqu\\xed administras todos los colaboradores de tu organizaci\\xf3n: usuarios activos, invitaciones enviadas, enlaces de acceso y solicitudes de uni\\xf3n pendientes.\"},\"stats\":{\"title\":\"Resumen del equipo\",\"content\":\"Estas tarjetas muestran el total de usuarios, cu\\xe1ntos est\\xe1n activos, cu\\xe1ntos tienen invitaci\\xf3n pendiente, cu\\xe1ntos son administradores y las solicitudes de uni\\xf3n recibidas.\"},\"filters\":{\"title\":\"Busca y filtra\",\"content\":\"Usa las pesta\\xf1as para cambiar entre usuarios, invitaciones, enlaces y solicitudes. Aplica filtros por rol, estado, regi\\xf3n, zona o equipo para localizar exactamente a quien necesitas.\"},\"list\":{\"title\":\"Lista de usuarios\",\"content\":\"Aqu\\xed aparecen los usuarios de la pesta\\xf1a activa. Haz clic en un usuario para ver su perfil, cambiar su rol o gestionar su acceso a cursos y rutas.\"},\"actions\":{\"title\":\"Acciones de gesti\\xf3n\",\"content\":\"Desde estos botones puedes actualizar la lista, exportar o importar usuarios en bloque, enviar invitaciones individuales o crear un nuevo usuario directamente.\"},\"soflia\":{\"title\":\"Tu asistente SofLIA\",\"content\":\"SofLIA puede ayudarte a entender el estado de tu equipo, sugerirte c\\xf3mo estructurar las invitaciones y resolver dudas sobre la gesti\\xf3n de usuarios.\"}},\"businessPanelHierarchy\":{\"header\":{\"title\":\"Gesti\\xf3n de estructura\",\"content\":\"Desde este panel defines c\\xf3mo se organiza tu empresa: regiones, zonas y equipos que agrupan a tus colaboradores para reportes y asignaciones de cursos.\"},\"tabs\":{\"title\":\"Vistas del panel\",\"content\":\"Usa la pesta\\xf1a \\xc1rbol para ver y gestionar la estructura visual, o Configuraci\\xf3n para activar y personalizar la jerarqu\\xeda de tu organizaci\\xf3n.\"},\"structureSelector\":{\"title\":\"Selector de estructura\",\"content\":\"Si tienes varias estructuras activas, este selector te permite cambiar entre ellas para ver o editar la que necesitas en cada momento.\"},\"actions\":{\"title\":\"Gestionar tu equipo\",\"content\":\"Agrega miembros directamente a la estructura ra\\xedz o crea una nueva estructura completa para segmentar tu organizaci\\xf3n de forma distinta.\"},\"treeBody\":{\"title\":\"\\xc1rbol jer\\xe1rquico\",\"content\":\"Este \\xe1rbol muestra regiones, zonas y equipos en cascada. Expande nodos, edita nombres, agrega subniveles o elimina ramas que ya no uses.\"},\"soflia\":{\"title\":\"Tu asistente SofLIA\",\"content\":\"SofLIA puede ayudarte a entender c\\xf3mo configurar la estructura de tu organizaci\\xf3n y c\\xf3mo influye en la asignaci\\xf3n de rutas y cursos.\"}},\"businessPanelCourses\":{\"hero\":{\"title\":\"Cat\\xe1logo de cursos\",\"content\":\"Este panel muestra todos los cursos disponibles para tu organizaci\\xf3n. Desde aqu\\xed puedes explorarlos, asignarlos a tu equipo y hacer seguimiento.\"},\"stats\":{\"title\":\"M\\xe9tricas del cat\\xe1logo\",\"content\":\"Estas tarjetas resumen el total de cursos, categor\\xedas disponibles, niveles de dificultad y n\\xfamero total de estudiantes en tu organizaci\\xf3n.\"},\"filters\":{\"title\":\"Busca y filtra\",\"content\":\"Escribe un nombre, instructor o descripci\\xf3n para localizar cursos r\\xe1pidamente, o aplica filtros por categor\\xeda y nivel de dificultad.\"},\"viewToggle\":{\"title\":\"Vista del cat\\xe1logo\",\"content\":\"Alterna entre cuadr\\xedcula para explorar visualmente o lista para comparar y encontrar cursos de forma m\\xe1s r\\xe1pida.\"},\"grid\":{\"title\":\"Cursos disponibles\",\"content\":\"Cada tarjeta muestra portada, t\\xedtulo, categor\\xeda, nivel e instructor. Haz clic en cualquier curso para ver su detalle completo y opciones de asignaci\\xf3n.\"},\"firstCard\":{\"title\":\"\\xa1Listo para explorar!\",\"content\":\"Cierra el tour con \\xa1Entendido! y luego haz clic en cualquier curso para ver su detalle completo: contenido, rese\\xf1as, instructor y la opci\\xf3n de asignarlo a tu equipo.\"}},\"businessPanelCourseDetail\":{\"hero\":{\"title\":\"Informaci\\xf3n del curso\",\"content\":\"Este encabezado resume lo esencial: portada, t\\xedtulo, categor\\xeda, nivel, duraci\\xf3n e instructor. Te da contexto r\\xe1pido antes de explorar el contenido.\"},\"tabsContainer\":{\"title\":\"Secciones del curso\",\"content\":\"Navega entre Informaci\\xf3n general, Contenido por m\\xf3dulos, Rese\\xf1as de usuarios e Instructor para conocer el curso a fondo antes de asignarlo.\"},\"sidebar\":{\"title\":\"Asignar y adquirir\",\"content\":\"Desde este panel lateral puedes asignar el curso a miembros de tu equipo o gestionarlo seg\\xfan la disponibilidad y los permisos de tu organizaci\\xf3n.\"},\"soflia\":{\"title\":\"Tu asistente SofLIA\",\"content\":\"SofLIA puede ayudarte a decidir si este curso es el adecuado para tu equipo y sugerirte c\\xf3mo estructurar la asignaci\\xf3n.\"}},\"businessPanelReports\":{\"hero\":{\"title\":\"Centro de reportes y anal\\xedtica\",\"content\":\"Este panel centraliza todas las m\\xe9tricas clave de tu organizaci\\xf3n. Desde aqu\\xed puedes exportar datos, generar an\\xe1lisis con IA y aplicar filtros temporales, por \\xe1rea, rol o equipo para explorar resultados espec\\xedficos.\"},\"filters\":{\"title\":\"Filtros de an\\xe1lisis\",\"content\":\"Delimita el per\\xedodo usando fecha de inicio y fin. Filtra por \\xe1rea, rol, regi\\xf3n, zona o equipo. Todos los paneles del reporte se actualizan en tiempo real con cada cambio que apliques aqu\\xed.\"},\"kpi\":{\"title\":\"KPIs ejecutivos\",\"content\":\"Las tarjetas superiores muestran los indicadores m\\xe1s cr\\xedticos de un vistazo: total de usuarios asignados, cu\\xe1ntos est\\xe1n activos, el progreso promedio de la organizaci\\xf3n, la tasa de finalizaci\\xf3n de cursos, el cumplimiento general y los usuarios en riesgo. Son el term\\xf3metro r\\xe1pido del estado formativo.\"},\"workforce\":{\"title\":\"Estado de la fuerza laboral\",\"content\":\"Esta gr\\xe1fica de dona muestra la distribuci\\xf3n real de tu equipo por etapa de aprendizaje: Sin iniciar, En proceso, Avanzando y Completaron. Los n\\xfameros reflejan headcount real, no estimaciones. \\xdasala para identificar de inmediato cu\\xe1ntos colaboradores todav\\xeda no han comenzado su formaci\\xf3n.\"},\"radar\":{\"title\":\"Perfil de salud organizacional\",\"content\":\"El radar eval\\xfaa tu organizaci\\xf3n en seis dimensiones simult\\xe1neas: Actividad (uso activo de la plataforma), Progreso (avance promedio en cursos), Cumplimiento (finalizaci\\xf3n vs. meta), Calidad acad\\xe9mica (rendimiento en evaluaciones), SofLIA (adopci\\xf3n del asistente IA) y Planificaci\\xf3n (uso del planificador de estudio). La l\\xednea punteada marca la meta del 70%. Cuanto m\\xe1s lleno est\\xe1 el radar, m\\xe1s saludable es tu organizaci\\xf3n.\"},\"compliance\":{\"title\":\"Cumplimiento por \\xe1rea\",\"content\":\"Esta gr\\xe1fica de barras horizontales muestra la tasa de finalizaci\\xf3n de cursos desglosada por \\xe1rea o departamento. Es la m\\xe1s accionable para RRHH: identifica al instante qu\\xe9 \\xe1reas est\\xe1n por debajo de la meta y requieren intervenci\\xf3n. Haz clic en una barra para filtrar el resto del reporte por esa \\xe1rea.\"},\"riskUsers\":{\"title\":\"Usuarios en riesgo\",\"content\":\"Esta tabla lista a los colaboradores con mayor probabilidad de abandono, ordenados por nivel de riesgo (Alto, Medio). Para cada usuario ves su \\xe1rea, cursos asignados, progreso actual, d\\xedas sin actividad y la causa del riesgo detectada. \\xdasala para priorizar intervenciones directas antes de que el usuario abandone por completo.\"},\"funnel\":{\"title\":\"Embudo de aprendizaje\",\"content\":\"El embudo muestra en qu\\xe9 etapa se pierde el avance hacia la finalizaci\\xf3n. De izquierda a derecha: Asignados → Iniciaron → M\\xe1s del 25% → M\\xe1s del 50% → M\\xe1s del 75% → Completaron. El porcentaje en rojo indica la ca\\xedda entre etapas. Identifica en cu\\xe1l escal\\xf3n hay mayor deserci\\xf3n para enfocar ah\\xed las acciones de seguimiento.\"},\"courseRisk\":{\"title\":\"Cursos con mayor riesgo operativo\",\"content\":\"Esta tabla ordena los cursos por riesgo operativo compuesto, considerando el n\\xfamero de asignados, cu\\xe1ntos est\\xe1n activos, el progreso promedio, la tasa de finalizaci\\xf3n, los vencimientos pendientes y la se\\xf1al de riesgo global. Los cursos con m\\xe1s rojo necesitan atenci\\xf3n inmediata: pueden tener fechas l\\xedmite pr\\xf3ximas o baja adherencia.\"},\"scatter\":{\"title\":\"Mapa de posicionamiento de equipos\",\"content\":\"Cada burbuja representa un equipo. El eje X muestra el progreso promedio y el eje Y la tasa de finalizaci\\xf3n. El tama\\xf1o de la burbuja indica la cantidad de usuarios del equipo. Los equipos en el cuadrante superior derecho son saludables; los que aparecen en rojo, en la esquina inferior izquierda, requieren atenci\\xf3n urgente. Cambia entre Equipos, Regiones y Zonas con las pesta\\xf1as superiores.\"},\"ranking\":{\"title\":\"Clasificaci\\xf3n de aprovechamiento\",\"content\":\"Ordena usuarios, equipos, regiones y zonas por un score compuesto que combina progreso, finalizaci\\xf3n, calidad acad\\xe9mica y adopci\\xf3n de herramientas. Usa las pesta\\xf1as para cambiar entre vistas. Los primeros lugares tienen pr\\xe1cticas que vale la pena identificar y compartir; los \\xfaltimos pueden necesitar apoyo adicional.\"},\"segments\":{\"title\":\"Desempe\\xf1o por segmento\",\"content\":\"Compara el desempe\\xf1o formativo entre Equipos, Puestos, Regiones y Zonas. Para cada segmento ves el n\\xfamero de usuarios, el progreso promedio, la tasa de finalizaci\\xf3n y los vencimientos. Es la herramienta clave para detectar brechas de formaci\\xf3n entre grupos y decidir d\\xf3nde concentrar los esfuerzos de desarrollo.\"},\"trend\":{\"title\":\"Evoluci\\xf3n del aprendizaje\",\"content\":\"Esta gr\\xe1fica de l\\xednea muestra la evoluci\\xf3n del n\\xfamero de cursos completados a lo largo del tiempo, semana a semana. Identifica picos de actividad (quiz\\xe1s tras una campa\\xf1a de recordatorio), per\\xedodos de ca\\xedda sostenida o tendencias de mejora continua. \\xdasala para correlacionar acciones de gesti\\xf3n con resultados reales.\"},\"academic\":{\"title\":\"Rendimiento acad\\xe9mico\",\"content\":\"Las cuatro tarjetas muestran la calidad del aprendizaje en el per\\xedodo filtrado: Promedio de evaluaciones (score de quizzes), Tasa de aprobaci\\xf3n (porcentaje de evaluaciones aprobadas), Actividades completadas (ejercicios finalizados) y Actividades pendientes. Un promedio de evaluaciones alto con baja tasa de finalizaci\\xf3n indica dificultades de adherencia, no de comprensi\\xf3n.\"},\"sofliaQuality\":{\"title\":\"Calidad e interacci\\xf3n con SofLIA\",\"content\":\"Mide c\\xf3mo tu equipo usa el asistente IA. Ver\\xe1s: usuarios activos con SofLIA, total de conversaciones, mensajes por sesi\\xf3n y tasa de resoluci\\xf3n. Debajo, la calidad de respuestas desglosa el tipo de preguntas (generales, de curso, de soporte). El uso por contexto muestra en qu\\xe9 \\xe1reas de la plataforma se consulta m\\xe1s a SofLIA: general, curso o planificador.\"},\"planner\":{\"title\":\"Planificador de estudio\",\"content\":\"Analiza la adherencia de tu equipo al plan de estudio generado por SofLIA. Ves cu\\xe1ntas sesiones fueron programadas vs. completadas, la varianza de tiempo (diferencia entre lo planeado y lo real), y el porcentaje de usuarios que efectivamente usan el planificador. Una adherencia baja puede indicar que los planes son poco realistas o que falta seguimiento.\"},\"notes\":{\"title\":\"Notas y apuntes\",\"content\":\"Muestra la adopci\\xf3n del cuaderno de notas: total de notas creadas, usuarios con al menos una nota y tasa de adopci\\xf3n general. El gr\\xe1fico distingue entre notas auto-generadas (creadas por SofLIA al finalizar una lecci\\xf3n) y manuales (escritas por el usuario). Una alta proporci\\xf3n de notas manuales indica compromiso activo con el aprendizaje.\"},\"insights\":{\"title\":\"An\\xe1lisis inteligente con IA\",\"content\":\"SofLIA analiza todos los datos del reporte y genera un informe ejecutivo con hallazgos clave, patrones de riesgo detectados y recomendaciones accionables priorizadas. Haz clic en Analizar con IA y espera unos segundos. Cuando est\\xe9 listo, puedes exportarlo como PDF para compartirlo con tu equipo directivo o de RRHH.\"}},\"businessPanelReviews\":{\"header\":{\"title\":\"Revisi\\xf3n de cursos\",\"content\":\"Este panel centraliza los cursos que necesitan tu aprobaci\\xf3n antes de estar disponibles para los usuarios de la organizaci\\xf3n. Aqu\\xed gestionas el flujo de aprobaci\\xf3n, rechazo y seguimiento de actualizaciones de contenido.\"},\"stats\":{\"title\":\"Estado de las revisiones\",\"content\":\"Estas tarjetas muestran cu\\xe1ntos cursos est\\xe1n pendientes de revisi\\xf3n, cu\\xe1ntos fueron rechazados, cu\\xe1ntos tienen actualizaciones recientes disponibles y cu\\xe1ntos son contenidos nuevos que a\\xfan no han sido evaluados.\"},\"filters\":{\"title\":\"Filtra y busca cursos\",\"content\":\"Usa las pesta\\xf1as para alternar entre Pendientes, Rechazados, Actualizaciones y Nuevos. El campo de b\\xfasqueda te permite localizar un curso espec\\xedfico por nombre dentro de la pesta\\xf1a activa.\"},\"grid\":{\"title\":\"Cursos por revisar\",\"content\":\"Cada tarjeta muestra la portada, el t\\xedtulo, la categor\\xeda y las acciones disponibles seg\\xfan el estado del curso. Puedes aprobar un curso para que est\\xe9 disponible en la organizaci\\xf3n, rechazarlo con un comentario o abrirlo para revisar su contenido en detalle antes de decidir.\"},\"soflia\":{\"title\":\"Tu asistente SofLIA\",\"content\":\"SofLIA puede ayudarte a evaluar si un curso es adecuado para tu equipo, comparar opciones y redactar comentarios de rechazo claros y constructivos.\"}},\"businessPanelSettings\":{\"hero\":{\"title\":\"Configuraci\\xf3n de la organizaci\\xf3n\",\"content\":\"Desde aqu\\xed gestionas toda la configuraci\\xf3n de tu organizaci\\xf3n en un solo lugar: nombre, idioma, zona horaria, contexto de SofLIA y personalizaci\\xf3n visual. Los cambios se aplican de forma inmediata para todos los usuarios de la organizaci\\xf3n.\"},\"tabs\":{\"title\":\"Secciones de configuraci\\xf3n\",\"content\":\"La pesta\\xf1a Organizaci\\xf3n concentra los datos generales: informaci\\xf3n b\\xe1sica, datos de contacto, contexto que SofLIA usar\\xe1 para responder a tu equipo y opciones de acceso. La pesta\\xf1a Branding (plan Enterprise) permite personalizar el logo, favicon y los colores de la plataforma para que reflejen la identidad visual de tu empresa.\"},\"soflia\":{\"title\":\"Tu asistente SofLIA\",\"content\":\"SofLIA puede ayudarte a redactar el contexto organizacional, sugerir configuraciones seg\\xfan el tipo de empresa y resolver dudas sobre qu\\xe9 opciones afectan a los usuarios finales.\"}},\"businessPanelLearningPaths\":{\"hero\":{\"title\":\"Rutas de aprendizaje\",\"content\":\"Las rutas agrupan cursos en un orden definido para guiar a tu equipo a trav\\xe9s de un proceso de formaci\\xf3n completo y progresivo.\"},\"stats\":{\"title\":\"M\\xe9tricas de rutas\",\"content\":\"Consulta cu\\xe1ntas rutas est\\xe1n activas, cu\\xe1ntos talleres incluyen, cu\\xe1ntos usuarios las tienen asignadas y el total de asignaciones vigentes.\"},\"search\":{\"title\":\"Busca una ruta\",\"content\":\"Escribe el nombre de una ruta para localizarla r\\xe1pidamente dentro del cat\\xe1logo y acceder a sus detalles o asignaciones.\"},\"cards\":{\"title\":\"Cat\\xe1logo de rutas\",\"content\":\"Cada tarjeta muestra el nombre, descripci\\xf3n, cursos incluidos y opciones para gestionar y asignar la ruta a tu equipo.\"},\"assignments\":{\"title\":\"Asignaciones activas\",\"content\":\"Esta secci\\xf3n lista qu\\xe9 usuarios o grupos tienen cada ruta asignada, con la fecha de asignaci\\xf3n y el estado actual de avance.\"},\"soflia\":{\"title\":\"Tu asistente SofLIA\",\"content\":\"SofLIA puede ayudarte a dise\\xf1ar rutas de formaci\\xf3n, entender el progreso de tu equipo y sugerir el orden \\xf3ptimo de los cursos.\"}}}'),b=JSON.parse('{\"navigation\":{\"backHome\":\"Volver al inicio\"},\"metadata\":{\"lastUpdated\":\"\\xdaltima actualizaci\\xf3n: {{date}}\",\"effectiveDate\":\"Vigente desde el 27 de julio de 2026\",\"version\":\"Versi\\xf3n 2.0\"},\"pages\":{\"contactLink\":\"contactarnos\",\"footerSuffix\":\".\",\"terms\":{\"footerPrefix\":\"Si tiene preguntas sobre estos t\\xe9rminos, puede\"},\"privacy\":{\"footerPrefix\":\"Si tiene preguntas sobre esta pol\\xedtica, puede\"}},\"modal\":{\"title\":\"Documentos legales\",\"close\":\"Cerrar\",\"accept\":\"Aceptar y continuar\"},\"tabs\":{\"terms\":\"T\\xe9rminos y condiciones\",\"privacy\":\"Pol\\xedtica de privacidad\",\"conduct\":\"C\\xf3digo de conducta\"},\"documents\":{\"terms\":{\"title\":\"T\\xe9rminos y Condiciones de Uso\",\"summary\":\"Reglas claras para utilizar SofLIA, contratar sus servicios y trabajar responsablemente con sus funciones educativas y de inteligencia artificial.\",\"sections\":[{\"number\":1,\"title\":\"Identidad de las Partes y Aceptaci\\xf3n\",\"content\":\"Estos T\\xe9rminos forman un acuerdo entre la persona f\\xedsica o moral identificada como proveedor en la propuesta, orden de servicio, contrato, factura o comprobante fiscal aplicable, operadora de la plataforma SofLIA bajo la marca Pulse Hub (el \\xabProveedor\\xbb), y la persona que accede al servicio (\\xabUsuario\\xbb). Si utiliza SofLIA por cuenta de una organizaci\\xf3n, declara tener facultades para obligarla. Al registrarse, aceptar una orden o usar la Plataforma, acepta estos T\\xe9rminos; si no est\\xe1 de acuerdo, no debe utilizarla.\"},{\"number\":2,\"title\":\"Definiciones y Orden Contractual\",\"content\":\"Para interpretar este acuerdo se aplican las siguientes definiciones y reglas de prelaci\\xf3n:\",\"list\":[\"\\xabPlataforma\\xbb comprende el sitio, aplicaciones, Pulse Hub, cursos, comunidad, integraciones, APIs y funciones de IA de SofLIA.\",\"\\xabOrganizaci\\xf3n Cliente\\xbb es la empresa o instituci\\xf3n que contrata o administra cuentas para su personal.\",\"\\xabOrden\\xbb es la cotizaci\\xf3n, propuesta, orden de servicio o checkout que describe plan, precio, vigencia y alcance.\",\"\\xabContenido del Usuario\\xbb incluye archivos, mensajes, prompts, respuestas, comentarios y materiales aportados por el Usuario.\",\"En caso de conflicto, prevalecen el contrato marco o acuerdo de tratamiento de datos, despu\\xe9s la Orden y finalmente estos T\\xe9rminos, salvo derechos obligatorios de consumidores.\"]},{\"number\":3,\"title\":\"Elegibilidad, Autoridad y Cuenta\",\"content\":\"El Usuario debe tener al menos 18 a\\xf1os y capacidad legal para contratar. Debe proporcionar informaci\\xf3n verdadera, mantenerla actualizada, proteger sus credenciales y activar los controles de seguridad disponibles. Las cuentas son personales, salvo perfiles t\\xe9cnicos expresamente autorizados. El Usuario notificar\\xe1 de inmediato cualquier acceso no reconocido y responde por la actividad que razonablemente pueda atribuirse a su cuenta hasta dicha notificaci\\xf3n.\"},{\"number\":4,\"title\":\"Alcance del Servicio\",\"content\":\"SofLIA ofrece capacitaci\\xf3n organizacional en inteligencia artificial, rutas de aprendizaje, evaluaciones, certificados, comunidad, anal\\xedtica, administraci\\xf3n de equipos, asistentes de IA e integraciones opcionales. Las funciones concretas dependen del plan y de la Orden. El Proveedor puede mejorar o sustituir funciones sin reducir materialmente el servicio contratado durante su vigencia; cualquier cambio material adverso se notificar\\xe1 con anticipaci\\xf3n razonable.\"},{\"number\":5,\"title\":\"Organizaciones, Administradores y Visibilidad\",\"content\":\"Cuando una Organizaci\\xf3n Cliente asigna una cuenta, sus administradores autorizados pueden gestionar accesos y consultar datos relacionados con la relaci\\xf3n organizacional, como identidad laboral, cursos asignados, avance, resultados, certificados, actividad y reportes. La Organizaci\\xf3n Cliente es responsable de informar a su personal, contar con una base jur\\xeddica v\\xe1lida, limitar permisos y utilizar los reportes \\xfanicamente para fines leg\\xedtimos. Un administrador no puede acceder a conversaciones o contenido privado salvo que la interfaz lo indique, exista habilitaci\\xf3n contractual y el tratamiento sea l\\xedcito.\"},{\"number\":6,\"title\":\"Funciones de Inteligencia Artificial\",\"content\":\"SofLIA puede generar recomendaciones, explicaciones, planes, ejercicios, evaluaciones preliminares y otros resultados mediante IA. El Usuario entiende que estos resultados son probabil\\xedsticos, pueden contener errores o sesgos y deben verificarse antes de usarse. La IA no sustituye asesor\\xeda legal, m\\xe9dica, financiera, laboral, de seguridad u otra asesor\\xeda profesional, ni debe utilizarse como \\xfanica base para decisiones con efectos jur\\xeddicos o similares sobre una persona.\"},{\"number\":7,\"title\":\"Supervisi\\xf3n Humana y Transparencia de IA\",\"content\":\"La Plataforma identifica las experiencias en las que el Usuario interact\\xfaa directamente con IA cuando ello no resulte evidente. El Usuario debe aplicar supervisi\\xf3n humana proporcional al riesgo, comprobar fuentes y revelar el origen artificial de contenido cuando la ley, el contexto profesional o los derechos de terceros lo exijan. Si una Organizaci\\xf3n Cliente utiliza resultados para evaluar personal, deber\\xe1 establecer criterios humanos de revisi\\xf3n, canales de impugnaci\\xf3n y medidas contra discriminaci\\xf3n.\"},{\"number\":8,\"title\":\"Uso Aceptable\",\"content\":\"El Usuario utilizar\\xe1 la Plataforma \\xfanicamente para fines l\\xedcitos, educativos y profesionales compatibles con el plan contratado. Debe respetar la privacidad, la propiedad intelectual, las pol\\xedticas de su organizaci\\xf3n y las instrucciones de seguridad; obtener permisos antes de cargar datos o materiales de terceros; y revisar los resultados antes de compartirlos o convertirlos en decisiones.\"},{\"number\":9,\"title\":\"Usos Prohibidos\",\"content\":\"No se permite:\",\"list\":[\"Acceder a cuentas, sistemas, modelos, prompts internos o \\xe1reas restringidas sin autorizaci\\xf3n.\",\"Introducir malware, eludir controles, realizar pruebas de intrusi\\xf3n no autorizadas o afectar la disponibilidad del servicio.\",\"Extraer datos o contenido mediante scraping, bots o automatizaci\\xf3n no autorizada, ni intentar reconstruir modelos o bases de datos.\",\"Generar fraude, suplantaci\\xf3n, acoso, discriminaci\\xf3n, explotaci\\xf3n sexual, violencia ilegal o instrucciones destinadas a causar da\\xf1o.\",\"Cargar secretos, datos personales o informaci\\xf3n confidencial sin autorizaci\\xf3n y salvaguardas adecuadas.\",\"Presentar resultados de IA como hechos verificados o como obra exclusivamente humana cuando esa omisi\\xf3n sea enga\\xf1osa o il\\xedcita.\",\"Usar la Plataforma para decisiones automatizadas de alto impacto sin evaluaci\\xf3n jur\\xeddica, controles humanos y autorizaci\\xf3n contractual.\"]},{\"number\":10,\"title\":\"Contenido del Usuario\",\"content\":\"El Usuario conserva sus derechos sobre el Contenido del Usuario y declara que puede aportarlo l\\xedcitamente. Otorga al Proveedor una licencia limitada, no exclusiva, mundial y durante el tiempo necesario para alojar, reproducir, transformar t\\xe9cnicamente y procesar dicho contenido con el \\xfanico fin de prestar, proteger y mejorar el servicio conforme a la Pol\\xedtica de Privacidad y a la configuraci\\xf3n contratada. Esta licencia no autoriza vender el contenido ni usar informaci\\xf3n confidencial para publicidad de terceros.\"},{\"number\":11,\"title\":\"Resultados Generados y Derechos de Terceros\",\"content\":\"En la medida permitida por la ley y sujeto a derechos de terceros, el Usuario puede utilizar los resultados generados para sus fines autorizados. Debido a la naturaleza de la IA, resultados similares pueden generarse para otras personas y no se garantiza exclusividad ni registrabilidad. El Usuario debe revisar posibles infracciones, atribuciones, licencias y restricciones antes de publicar o explotar un resultado.\"},{\"number\":12,\"title\":\"Propiedad Intelectual y Retroalimentaci\\xf3n\",\"content\":\"La Plataforma, su software, modelos, dise\\xf1o, marcas, cursos, documentaci\\xf3n y materiales propios o licenciados pertenecen al Proveedor o a sus titulares. La suscripci\\xf3n concede un derecho limitado, revocable, no transferible y no sublicenciable de uso durante la vigencia contratada. Si el Usuario env\\xeda ideas o sugerencias, autoriza utilizarlas sin obligaci\\xf3n de compensaci\\xf3n, siempre que no incorporen informaci\\xf3n confidencial ni datos personales identificables.\"},{\"number\":13,\"title\":\"Contenido e Integraciones de Terceros\",\"content\":\"Algunos contenidos, enlaces, modelos o integraciones pertenecen a terceros y se rigen adem\\xe1s por sus t\\xe9rminos. SofLIA no controla servicios externos y no responde por cambios o indisponibilidad ajenos a su control. Antes de habilitar una integraci\\xf3n, el Usuario ver\\xe1 los permisos solicitados y podr\\xe1 revocarla desde la Plataforma o desde el proveedor externo, aunque la revocaci\\xf3n puede limitar la funcionalidad asociada.\"},{\"number\":14,\"title\":\"Calendarios y Herramientas Conectadas\",\"content\":\"Las integraciones de calendario son opcionales y se destinan a detectar disponibilidad o programar actividades autorizadas. SofLIA limitar\\xe1 el acceso a los permisos mostrados en la pantalla de consentimiento y a la finalidad informada. El Usuario no debe conectar una cuenta corporativa sin autorizaci\\xf3n de su organizaci\\xf3n y puede retirar el acceso en cualquier momento.\"},{\"number\":15,\"title\":\"Planes, Precios, Impuestos y Facturaci\\xf3n\",\"content\":\"La Orden o pantalla de contrataci\\xf3n mostrar\\xe1 antes del pago el plan, moneda, periodicidad, impuestos aplicables, cargos totales, medios de pago, duraci\\xf3n, renovaci\\xf3n y funciones incluidas. El Usuario autoriza los cargos expresamente aceptados. Los pagos pueden ser procesados por terceros; SofLIA no almacena el n\\xfamero completo de tarjeta. Las facturas se emiten con los datos fiscales proporcionados y dentro de los plazos aplicables.\"},{\"number\":16,\"title\":\"Renovaci\\xf3n, Cancelaci\\xf3n y Reembolsos\",\"content\":\"La renovaci\\xf3n autom\\xe1tica solo se aplicar\\xe1 si fue informada y aceptada, con instrucciones accesibles para desactivarla. La cancelaci\\xf3n detiene cargos futuros y conserva el acceso hasta el fin del periodo pagado, salvo que la Orden disponga una terminaci\\xf3n distinta. Reembolsos, periodos m\\xednimos y cr\\xe9ditos se rigen por la Orden y por la ley. Nada en estos T\\xe9rminos elimina derechos irrenunciables de revocaci\\xf3n, bonificaci\\xf3n, garant\\xeda o devoluci\\xf3n que correspondan a consumidores.\"},{\"number\":17,\"title\":\"Pruebas, Funciones Beta y Disponibilidad\",\"content\":\"Las pruebas gratuitas y funciones beta pueden tener l\\xedmites, modificarse o concluir con aviso razonable y se ofrecen para evaluaci\\xf3n. Los compromisos de nivel de servicio solo existen si constan en una Orden o SLA. El Proveedor realiza mantenimiento, continuidad y recuperaci\\xf3n proporcionales al servicio, pero no garantiza operaci\\xf3n ininterrumpida; cuando sea razonablemente posible, avisar\\xe1 mantenimientos programados con impacto material.\"},{\"number\":18,\"title\":\"Aprendizaje, Evaluaciones y Certificados\",\"content\":\"Los certificados acreditan la finalizaci\\xf3n o resultado registrado en SofLIA, pero no constituyen por s\\xed mismos un grado acad\\xe9mico, licencia profesional, garant\\xeda de empleo o certificaci\\xf3n oficial, salvo que se indique expresamente. La Organizaci\\xf3n Cliente determina el efecto interno de los resultados y debe evitar decisiones injustificadas basadas exclusivamente en m\\xe9tricas automatizadas.\"},{\"number\":19,\"title\":\"Privacidad, Datos Personales y Encargo\",\"content\":\"La Pol\\xedtica de Privacidad forma parte de estos T\\xe9rminos. Cuando SofLIA determina fines propios act\\xfaa como responsable; cuando procesa datos que una Organizaci\\xf3n Cliente controla, act\\xfaa como encargado conforme a sus instrucciones y al acuerdo de tratamiento aplicable. La Organizaci\\xf3n Cliente garantiza que cuenta con avisos, bases jur\\xeddicas y autorizaciones necesarias para aportar datos, y el Proveedor aplicar\\xe1 medidas de seguridad y obligaciones de confidencialidad.\"},{\"number\":20,\"title\":\"Seguridad e Incidentes de Cuenta\",\"content\":\"Cada parte aplicar\\xe1 medidas razonables para proteger credenciales, dispositivos, integraciones y datos. El Usuario debe informar sin demora a soporte@soflia.com sobre accesos no autorizados, vulnerabilidades o p\\xe9rdida de credenciales y no divulgar p\\xfablicamente una vulnerabilidad antes de permitir su correcci\\xf3n responsable. El Proveedor investigar\\xe1 incidentes y realizar\\xe1 las notificaciones legalmente exigibles.\"},{\"number\":21,\"title\":\"Confidencialidad Empresarial\",\"content\":\"Cada parte proteger\\xe1 la informaci\\xf3n marcada como confidencial o que razonablemente deba entenderse como tal y la usar\\xe1 solo para ejecutar la relaci\\xf3n. Esta obligaci\\xf3n no cubre informaci\\xf3n p\\xfablica sin incumplimiento, ya conocida leg\\xedtimamente, recibida l\\xedcitamente de un tercero o desarrollada de forma independiente. Una divulgaci\\xf3n exigida por autoridad se limitar\\xe1 a lo requerido y, cuando sea legalmente posible, se notificar\\xe1 a la otra parte.\"},{\"number\":22,\"title\":\"Suspensi\\xf3n, Terminaci\\xf3n y Portabilidad\",\"content\":\"El Proveedor puede suspender proporcionalmente el acceso ante incumplimiento material, falta de pago, riesgo de seguridad, uso ilegal o requerimiento de autoridad, procurando avisar y permitir subsanaci\\xf3n cuando sea viable. Al terminar, cesa el derecho de uso. La Organizaci\\xf3n Cliente podr\\xe1 solicitar exportaci\\xf3n razonable de datos disponibles durante el plazo pactado y despu\\xe9s se eliminar\\xe1n o anonimizar\\xe1n conforme a la Pol\\xedtica de Privacidad, salvo conservaci\\xf3n legal.\"},{\"number\":23,\"title\":\"Garant\\xedas y Exclusiones\",\"content\":\"El Proveedor garantiza que prestar\\xe1 el servicio con diligencia razonable y de forma sustancialmente conforme a la documentaci\\xf3n vigente. Salvo garant\\xedas expresas de la Orden y las que no puedan excluirse por ley, la Plataforma se ofrece seg\\xfan disponibilidad. No se garantiza que cada contenido o resultado de IA sea exacto, completo o adecuado para un prop\\xf3sito particular. Las exclusiones no afectan derechos obligatorios de consumidores.\"},{\"number\":24,\"title\":\"Limitaci\\xf3n de Responsabilidad\",\"content\":\"En la m\\xe1xima medida permitida, ninguna parte responder\\xe1 por da\\xf1os indirectos, p\\xe9rdida de beneficios o p\\xe9rdida de oportunidad que no fueran previsibles. La responsabilidad agregada del Proveedor derivada del servicio no exceder\\xe1 las cantidades pagadas por el servicio afectado durante los doce meses anteriores al hecho. El l\\xedmite no aplica a fraude o dolo, culpa grave, lesiones, incumplimientos de confidencialidad o protecci\\xf3n de datos atribuibles a la parte, infracci\\xf3n de propiedad intelectual, obligaciones de pago ni responsabilidades que la ley proh\\xedba limitar.\"},{\"number\":25,\"title\":\"Indemnizaci\\xf3n\",\"content\":\"Una Organizaci\\xf3n Cliente defender\\xe1 e indemnizar\\xe1 al Proveedor frente a reclamaciones de terceros causadas por Contenido del Usuario il\\xedcito, instrucciones contrarias a la ley o uso materialmente incumplidor, siempre que reciba aviso oportuno, control razonable de la defensa y cooperaci\\xf3n. El Proveedor responder\\xe1 por reclamaciones de que su tecnolog\\xeda propia, usada conforme al contrato, infringe derechos de propiedad intelectual, pudiendo obtener una licencia, modificar o sustituir la funci\\xf3n, o terminarla y devolver la parte prepagada no utilizada. Esta cl\\xe1usula se limita por la ley aplicable.\"},{\"number\":26,\"title\":\"Fuerza Mayor\",\"content\":\"Ninguna parte ser\\xe1 responsable por retrasos causados por eventos fuera de su control razonable, como desastres, fallas generalizadas de telecomunicaciones, actos de autoridad, conflictos o ataques masivos, siempre que mitigue el impacto y reanude el cumplimiento cuanto antes. La fuerza mayor no excusa obligaciones de pago ya devengadas ni deberes de seguridad que razonablemente puedan mantenerse.\"},{\"number\":27,\"title\":\"Cambios, Avisos y Comunicaciones Electr\\xf3nicas\",\"content\":\"El Proveedor puede actualizar estos T\\xe9rminos por cambios legales, de seguridad o del servicio. Los cambios materiales se comunicar\\xe1n por la Plataforma o correo con anticipaci\\xf3n razonable y no alterar\\xe1n retroactivamente una Orden, salvo exigencia legal. Los avisos al Usuario se enviar\\xe1n al correo de cuenta; los avisos al Proveedor se enviar\\xe1n a soporte@soflia.com y al domicilio indicado en el documento contractual aplicable.\"},{\"number\":28,\"title\":\"Ley Aplicable, Reclamaciones y Soluci\\xf3n de Controversias\",\"content\":\"Estos T\\xe9rminos se rigen por las leyes de los Estados Unidos Mexicanos. Antes de demandar, las partes procurar\\xe1n resolver la controversia mediante una reclamaci\\xf3n escrita y negociaci\\xf3n de buena fe durante treinta d\\xedas. Si no se resuelve, ser\\xe1n competentes los tribunales de la Ciudad de M\\xe9xico, salvo competencia obligatoria distinta. Las personas consumidoras conservan sus derechos ante la Procuradur\\xeda Federal del Consumidor y cualquier foro o procedimiento irrenunciable.\"},{\"number\":29,\"title\":\"Disposiciones Generales\",\"content\":\"Estos T\\xe9rminos, la Orden, la Pol\\xedtica de Privacidad y los acuerdos incorporados constituyen el acuerdo aplicable. La nulidad de una cl\\xe1usula no afecta las dem\\xe1s; la falta de ejercicio no implica renuncia. El Usuario no puede ceder su cuenta o contrato sin consentimiento, mientras el Proveedor puede cederlo en una reorganizaci\\xf3n o venta sin reducir derechos. No se crea sociedad, mandato ni relaci\\xf3n laboral. Las cl\\xe1usulas que por su naturaleza deban subsistir continuar\\xe1n vigentes.\"},{\"number\":30,\"title\":\"Contacto e Identificaci\\xf3n Contractual\",\"content\":\"El proveedor legal, raz\\xf3n social, domicilio f\\xedsico, RFC y datos de facturaci\\xf3n aplicables son los que aparecen en su propuesta, Orden, contrato, factura o comprobante fiscal. Si accedi\\xf3 sin uno de esos documentos, solicite esa identificaci\\xf3n antes de contratar o proporcionar datos opcionales. Para soporte, cancelaciones, reclamaciones o avisos legales escriba a soporte@soflia.com o utilice el formulario de contacto de SofLIA.\"}]},\"privacy\":{\"title\":\"Pol\\xedtica de Privacidad\",\"summary\":\"Un aviso integral sobre qu\\xe9 datos tratamos, para qu\\xe9 los utilizamos, con qui\\xe9n pueden compartirse y c\\xf3mo conservar el control sobre su informaci\\xf3n.\",\"sections\":[{\"number\":1,\"title\":\"Responsable, Roles y Alcance\",\"content\":\"Para tratamientos en los que SofLIA determina los fines y medios, el responsable es la persona f\\xedsica o moral identificada como proveedor en la propuesta, orden de servicio, contrato, factura o comprobante fiscal aplicable, operadora de SofLIA bajo la marca Pulse Hub (el \\xabResponsable\\xbb). Su domicilio es el indicado en esos documentos y su canal de privacidad es soporte@soflia.com. Si no cuenta con un documento contractual, puede solicitar esa identificaci\\xf3n antes de proporcionar datos opcionales. Cuando una Organizaci\\xf3n Cliente decide finalidades y carga datos de su personal, esa organizaci\\xf3n act\\xfaa como responsable y el proveedor contractual de SofLIA como encargado conforme a sus instrucciones.\"},{\"number\":2,\"title\":\"A Qui\\xe9n y a Qu\\xe9 Aplica\",\"content\":\"Esta Pol\\xedtica aplica a visitantes, prospectos, usuarios, administradores, participantes de cursos, integrantes de organizaciones y personas que interact\\xfaan con el sitio, aplicaciones, Pulse Hub, soporte, comunidad, eventos, integraciones o funciones de IA de SofLIA. No cubre sitios o servicios de terceros que tengan su propio aviso, aunque est\\xe9n enlazados desde la Plataforma.\"},{\"number\":3,\"title\":\"Datos que Recopilamos\",\"content\":\"Tratamos solo las categor\\xedas necesarias para las finalidades informadas:\",\"list\":[\"Identificaci\\xf3n y contacto: nombre, correo, tel\\xe9fono, alias, idioma, pa\\xeds y datos de registro.\",\"Perfil profesional y organizacional: empresa, puesto, \\xe1rea, equipo, permisos, fotograf\\xeda, biograf\\xeda y preferencias opcionales.\",\"Cuenta y seguridad: identificadores, credenciales protegidas, sesiones, autenticaci\\xf3n multifactor, intentos de acceso y eventos de seguridad.\",\"Aprendizaje: inscripciones, rutas, lecciones, respuestas, calificaciones, notas, progreso, certificados y retroalimentaci\\xf3n.\",\"Contenido e interacciones: archivos, publicaciones, comentarios, solicitudes de soporte, prompts, respuestas de IA y, si se habilita, audio, transcripci\\xf3n o im\\xe1genes aportadas.\",\"Uso y dispositivo: p\\xe1ginas y funciones utilizadas, fechas, duraci\\xf3n, direcci\\xf3n IP, navegador, sistema operativo, dispositivo, registros t\\xe9cnicos y ubicaci\\xf3n aproximada derivada de IP.\",\"Contrataci\\xf3n: plan, organizaci\\xf3n, estado de suscripci\\xf3n, referencias de transacci\\xf3n, facturaci\\xf3n y datos fiscales; el procesador de pagos gestiona los datos completos de tarjeta.\",\"Integraciones autorizadas: identificadores, permisos y la informaci\\xf3n estrictamente necesaria para ejecutar la funci\\xf3n conectada.\"]},{\"number\":4,\"title\":\"Fuentes de los Datos\",\"content\":\"Obtenemos datos directamente del Usuario; autom\\xe1ticamente al usar la Plataforma; de la Organizaci\\xf3n Cliente que crea o administra la cuenta; de proveedores de identidad o integraciones que el Usuario autoriza; de procesadores de pago; y de fuentes p\\xfablicas o contactos empresariales leg\\xedtimos para gestionar una relaci\\xf3n B2B. Si una organizaci\\xf3n proporciona datos de otra persona, debe contar con base jur\\xeddica y entregarle el aviso correspondiente.\"},{\"number\":5,\"title\":\"Finalidades Primarias\",\"content\":\"Las finalidades necesarias para prestar y proteger el servicio son:\",\"list\":[\"Crear y autenticar cuentas, administrar permisos y mantener la seguridad.\",\"Prestar cursos, evaluaciones, certificados, comunidad, soporte, asistentes de IA y funciones contratadas.\",\"Personalizar rutas y recomendaciones conforme al progreso y preferencias.\",\"Gestionar suscripciones, pagos, facturaci\\xf3n, solicitudes, renovaciones y cumplimiento contractual.\",\"Enviar comunicaciones operativas, de seguridad, servicio y cambios legales.\",\"Generar reportes autorizados para la Organizaci\\xf3n Cliente y facilitar la gesti\\xf3n de su programa.\",\"Prevenir fraude, abuso, incidentes, violaciones de pol\\xedticas y usos il\\xedcitos.\",\"Cumplir obligaciones legales, atender autoridades y ejercer o defender derechos.\"]},{\"number\":6,\"title\":\"Finalidades Secundarias y Mercadotecnia\",\"content\":\"Con consentimiento cuando sea exigible, podemos enviar novedades, invitaciones, encuestas u ofertas y utilizar anal\\xedtica no esencial para comprender campa\\xf1as. Estas finalidades no son necesarias para usar el servicio. Puede rechazarlas desde el aviso o enlace de baja, la configuraci\\xf3n disponible o escribiendo a soporte@soflia.com, sin afectar su acceso ni el tratamiento ya realizado l\\xedcitamente.\"},{\"number\":7,\"title\":\"Bases Jur\\xeddicas y Consentimiento\",\"content\":\"Seg\\xfan la jurisdicci\\xf3n y el contexto, tratamos datos para ejecutar el contrato o medidas precontractuales, cumplir obligaciones legales, proteger intereses vitales, atender intereses leg\\xedtimos proporcionados como seguridad y mejora del servicio, o con consentimiento. Cuando el consentimiento sea la base, ser\\xe1 libre, informado, espec\\xedfico e inequ\\xedvoco; podr\\xe1 retirarse con la misma facilidad con que se otorg\\xf3 y sin efecto retroactivo.\"},{\"number\":8,\"title\":\"Inteligencia Artificial, Prompts y Resultados\",\"content\":\"Las funciones de IA procesan instrucciones y contexto para generar respuestas, recomendaciones, ejercicios o an\\xe1lisis. Las conversaciones pueden conservarse para continuidad, seguridad, soporte y mejora controlada conforme a la configuraci\\xf3n, contrato y base jur\\xeddica aplicables. No usamos conversaciones identificables para publicidad de terceros. El Usuario no debe incluir datos sensibles, secretos o datos de terceros que no est\\xe9 autorizado a tratar. Proveedores tecnol\\xf3gicos pueden procesar informaci\\xf3n como encargados bajo obligaciones de confidencialidad y seguridad.\"},{\"number\":9,\"title\":\"Decisiones Automatizadas y Perfilado\",\"content\":\"SofLIA puede usar progreso, respuestas y preferencias para recomendar contenido, estimar nivel o se\\xf1alar brechas. Estas funciones apoyan el aprendizaje y no est\\xe1n dise\\xf1adas para producir por s\\xed solas efectos jur\\xeddicos o de importancia similar. Si una Organizaci\\xf3n Cliente utiliza reportes para decisiones laborales, debe realizar revisi\\xf3n humana y ofrecer un canal de aclaraci\\xf3n. Cuando aplique, la persona puede solicitar informaci\\xf3n, expresar su punto de vista, impugnar el resultado u oponerse al tratamiento automatizado.\"},{\"number\":10,\"title\":\"Cuentas Empresariales y Administradores\",\"content\":\"Los administradores autorizados pueden ver identidad laboral, asignaciones, actividad, avance, resultados y certificados necesarios para gestionar el programa. La interfaz y el contrato determinan el alcance. SofLIA aplica permisos por rol; la Organizaci\\xf3n Cliente debe limitar accesos, informar a su personal y usar los datos para finalidades leg\\xedtimas. Conversaciones privadas o contenido no destinado a reportes no se muestran salvo indicaci\\xf3n clara, autorizaci\\xf3n y base jur\\xeddica.\"},{\"number\":11,\"title\":\"Calendarios e Integraciones\",\"content\":\"Si el Usuario conecta Google Calendar, Microsoft Outlook u otro servicio, la pantalla de autorizaci\\xf3n mostrar\\xe1 los permisos solicitados. SofLIA utiliza la informaci\\xf3n estrictamente necesaria para detectar disponibilidad, proponer horarios o crear actividades autorizadas; no utilizar\\xe1 detalles de eventos para publicidad. El Usuario puede revocar la integraci\\xf3n desde SofLIA o desde el proveedor externo. La revocaci\\xf3n detiene accesos futuros, pero no elimina registros que deban conservarse legalmente.\"},{\"number\":12,\"title\":\"Cookies y Tecnolog\\xedas Similares\",\"content\":\"Utilizamos cookies o almacenamiento local esenciales para sesi\\xf3n, seguridad, idioma y funcionamiento. Las cookies funcionales, anal\\xedticas o publicitarias no esenciales se activar\\xe1n con elecci\\xf3n previa cuando la ley lo requiera. El panel o banner disponible permitir\\xe1 aceptar, rechazar o modificar categor\\xedas con facilidad. Tambi\\xe9n puede limitar cookies desde su navegador, aunque algunas funciones esenciales podr\\xedan dejar de operar.\"},{\"number\":13,\"title\":\"Destinatarios y Encargados\",\"content\":\"No vendemos datos personales. Podemos comunicarlos, con acceso limitado y contratos adecuados, a proveedores de infraestructura, almacenamiento, autenticaci\\xf3n, correo, soporte, anal\\xedtica, IA, pagos y seguridad; a integraciones elegidas por el Usuario; a administradores autorizados de la Organizaci\\xf3n Cliente; a asesores profesionales sujetos a confidencialidad; a adquirentes en una reorganizaci\\xf3n con salvaguardas; y a autoridades cuando exista obligaci\\xf3n o solicitud legal v\\xe1lida.\"},{\"number\":14,\"title\":\"Transferencias Nacionales e Internacionales\",\"content\":\"Algunos encargados pueden operar fuera del pa\\xeds. Antes de transferir datos, evaluamos la finalidad y exigimos protecci\\xf3n compatible mediante cl\\xe1usulas contractuales, instrucciones, medidas t\\xe9cnicas y, cuando corresponda, decisiones de adecuaci\\xf3n o cl\\xe1usulas contractuales tipo. Las transferencias se limitan a lo necesario y se comunican conforme al aviso y a la ley. Puede solicitar informaci\\xf3n general sobre destinos y salvaguardas.\"},{\"number\":15,\"title\":\"Conservaci\\xf3n y Eliminaci\\xf3n\",\"content\":\"Conservamos datos mientras la cuenta o relaci\\xf3n est\\xe9 activa y despu\\xe9s solo durante el tiempo necesario para finalidades informadas, garant\\xedas, auditor\\xeda, seguridad, defensa de reclamaciones y obligaciones fiscales o legales. El plazo depende de la categor\\xeda, sensibilidad, riesgo y contrato. Los datos vinculados a un incumplimiento contractual podr\\xe1n conservarse bloqueados hasta setenta y dos meses cuando la legislaci\\xf3n mexicana lo permita o exija. Al concluir el plazo, se eliminan, anonimizan o bloquean de forma segura.\"},{\"number\":16,\"title\":\"Seguridad y Confidencialidad\",\"content\":\"Aplicamos medidas administrativas, t\\xe9cnicas y f\\xedsicas proporcionales al riesgo, como control de acceso y privilegio m\\xednimo, autenticaci\\xf3n, cifrado en tr\\xe1nsito, gesti\\xf3n de secretos, registro y monitoreo, respaldos, desarrollo seguro, evaluaci\\xf3n de proveedores, capacitaci\\xf3n y respuesta a incidentes. Las personas autorizadas est\\xe1n sujetas a confidencialidad. Ning\\xfan sistema es infalible, por lo que el Usuario tambi\\xe9n debe proteger sus credenciales y dispositivos.\"},{\"number\":17,\"title\":\"Incidentes y Vulneraciones\",\"content\":\"Cuando una vulneraci\\xf3n relevante afecte derechos patrimoniales o morales, investigaremos, mitigaremos el riesgo y notificaremos sin demora a las personas y autoridades que corresponda, describiendo la naturaleza del incidente, datos afectados, recomendaciones, acciones correctivas y un canal de informaci\\xf3n, en la medida permitida por la investigaci\\xf3n y la ley.\"},{\"number\":18,\"title\":\"Derechos ARCO\",\"content\":\"En M\\xe9xico puede solicitar Acceso, Rectificaci\\xf3n, Cancelaci\\xf3n u Oposici\\xf3n. Env\\xede la solicitud a soporte@soflia.com con nombre, medio para comunicar respuesta, documentos que acrediten identidad o representaci\\xf3n, descripci\\xf3n clara de los datos y derecho, y elementos que faciliten localizarlos. Para rectificaci\\xf3n, indique la correcci\\xf3n y adjunte soporte. Responderemos en un m\\xe1ximo de veinte d\\xedas y, si procede, haremos efectivo el derecho dentro de los quince d\\xedas siguientes; ambos plazos pueden ampliarse una sola vez por causa justificada.\"},{\"number\":19,\"title\":\"Revocaci\\xf3n y Limitaci\\xf3n de Uso\",\"content\":\"Puede revocar consentimiento o limitar divulgaci\\xf3n y comunicaciones no esenciales escribiendo a soporte@soflia.com, usando la baja incluida en mensajes o los controles disponibles. La solicitud es gratuita, salvo costos de reproducci\\xf3n o env\\xedo permitidos. La revocaci\\xf3n puede no proceder de forma inmediata cuando exista una obligaci\\xf3n legal, contractual o de defensa de derechos; explicaremos la raz\\xf3n y bloquearemos los datos cuando corresponda.\"},{\"number\":20,\"title\":\"Derechos Adicionales en el EEE y Reino Unido\",\"content\":\"Cuando el GDPR o normativa equivalente aplique, puede solicitar acceso, rectificaci\\xf3n, supresi\\xf3n, limitaci\\xf3n, oposici\\xf3n y portabilidad; retirar consentimiento; y reclamar ante la autoridad de control de su residencia, trabajo o lugar de la presunta infracci\\xf3n. Tambi\\xe9n puede oponerse al inter\\xe9s leg\\xedtimo y a mercadotecnia directa. Informaremos la base, los intereses leg\\xedtimos, destinatarios, transferencias y criterios de conservaci\\xf3n pertinentes.\"},{\"number\":21,\"title\":\"Datos Sensibles y Menores\",\"content\":\"SofLIA no requiere datos personales sensibles para el uso ordinario y pide no incluirlos en prompts, comunidad o archivos. Si una funci\\xf3n espec\\xedfica necesitara tratarlos, se identificar\\xe1n, limitar\\xe1n y se solicitar\\xe1 consentimiento expreso por escrito u otra base v\\xe1lida. El servicio general no est\\xe1 dirigido a menores de 18 a\\xf1os. Si una oferta educativa autorizada involucra menores, deber\\xe1 contar con aviso espec\\xedfico, consentimiento verificable y controles reforzados antes de recopilar datos.\"},{\"number\":22,\"title\":\"Cambios a la Pol\\xedtica\",\"content\":\"Podemos actualizar esta Pol\\xedtica por cambios de ley, producto, proveedores o pr\\xe1cticas. La fecha y versi\\xf3n identifican el texto vigente. Los cambios materiales se comunicar\\xe1n en la Plataforma o por correo antes de surtir efectos cuando corresponda; si introducen finalidades incompatibles o requieren nuevo consentimiento, no se aplicar\\xe1n hasta obtenerlo. Las versiones anteriores podr\\xe1n solicitarse al canal de privacidad.\"},{\"number\":23,\"title\":\"Contacto, Autoridades y Reclamaciones\",\"content\":\"Para preguntas, derechos o quejas escriba a soporte@soflia.com o utilice el formulario de contacto. El \\xe1rea que reciba la solicitud la turnar\\xe1 al responsable de privacidad y confirmar\\xe1 recepci\\xf3n. En M\\xe9xico, la autoridad competente bajo la LFPDPPP vigente es la Secretar\\xeda Anticorrupci\\xf3n y Buen Gobierno, sin perjuicio de otras autoridades competentes; en la Uni\\xf3n Europea puede acudir a la autoridad de control correspondiente. Tambi\\xe9n conserva los recursos administrativos o judiciales que la ley reconozca.\"}]},\"conduct\":{\"title\":\"C\\xf3digo de Conducta\",\"sections\":[{\"number\":1,\"title\":\"Comportamiento Esperado\",\"content\":\"Nuestra comunidad se basa en respeto, colaboraci\\xf3n y aprendizaje constructivo. Todas las personas deben tratar a otras con dignidad, contribuir de forma \\xfatil, respetar propiedad intelectual, mantener un entorno profesional e inclusivo y reportar riesgos cuando sea necesario.\"},{\"number\":2,\"title\":\"Comportamiento Prohibido\",\"content\":\"Se proh\\xedben el acoso, intimidaci\\xf3n, discriminaci\\xf3n, abuso, contenido ilegal, spam, suplantaci\\xf3n, divulgaci\\xf3n de datos de terceros, manipulaci\\xf3n de seguridad y cualquier actividad que vulnere leyes o derechos.\"},{\"number\":3,\"title\":\"Consecuencias y Reportes\",\"content\":\"El incumplimiento puede resultar en advertencias, retiro de contenido, suspensi\\xf3n, terminaci\\xf3n o reporte a autoridades. Los reportes se revisar\\xe1n con confidencialidad razonable mediante las herramientas de la Plataforma o soporte@soflia.com.\"}]}}}'),f=JSON.parse('{\"pageTitle\":\"Libro de apuntes\",\"pageSubtitle\":\"Organiza tus apuntes por curso y lecci\\xf3n\",\"backToDashboard\":\"Volver al panel\",\"search\":{\"placeholder\":\"Buscar por t\\xedtulo, curso, lecci\\xf3n o etiqueta...\"},\"views\":{\"timeline\":\"Actividad reciente\",\"tasks\":\"Tareas\"},\"filters\":{\"sourceLabel\":\"Origen\",\"knowledgeLabel\":\"Tipo\",\"lifecycleLabel\":\"Estado\",\"all\":\"Todos los tipos\",\"lifecycle\":{\"all\":\"Todos los estados\",\"draft\":\"Borrador\",\"enriched\":\"Enriquecido\",\"reviewed\":\"Revisado\",\"archived\":\"Archivado\",\"shared\":\"Compartido\",\"promoted\":\"Promovido\"}},\"source\":{\"all\":\"Todos\",\"manual\":\"Manual\",\"chat\":\"Conversaci\\xf3n SofLIA\",\"import\":\"Importado\",\"lesson_auto_note\":\"Apunte SofLIA\",\"course_compendium\":\"Compendio\"},\"generation\":{\"retry\":\"Reintentar generaci\\xf3n\",\"status\":{\"queued\":\"En cola\",\"processing\":\"Generando\",\"partial\":\"Parcial\",\"ready\":\"Listo\",\"failed\":\"Fall\\xf3\",\"stale\":\"Por actualizar\"},\"statusDescription\":{\"queued\":\"Tu cuaderno est\\xe1 en cola y comenzar\\xe1 a generarse en breve.\",\"processing\":\"SofLIA est\\xe1 organizando tus apuntes y aprendizajes.\",\"partial\":\"Ya puedes consultar una versi\\xf3n parcial; completaremos lo que falta autom\\xe1ticamente.\",\"ready\":\"Tu cuaderno est\\xe1 listo para consultarlo y ponerlo en pr\\xe1ctica.\",\"failed\":\"No se pudo completar la generaci\\xf3n. Puedes reintentarlo sin perder tus notas.\",\"stale\":\"Hay nuevos aprendizajes; el cuaderno necesita actualizarse.\"}},\"tasks\":{\"title\":\"Tareas de aprendizaje\",\"subtitle\":\"Convierte tus apuntes en acciones concretas y dales seguimiento.\",\"emptyTitle\":\"No hay tareas en este filtro\",\"emptyDescription\":\"Las acciones detectadas por SofLIA aparecer\\xe1n aqu\\xed para que decidas cu\\xe1les realizar.\",\"loadMore\":\"Cargar m\\xe1s\",\"filter\":{\"all\":\"Todas\",\"suggested\":\"Sugeridas\",\"open\":\"Pendientes\",\"done\":\"Completadas\",\"dismissed\":\"Descartadas\"},\"status\":{\"suggested\":\"Sugerida\",\"open\":\"Pendiente\",\"done\":\"Completada\",\"dismissed\":\"Descartada\"}},\"tree\":{\"aria\":\"Navegaci\\xf3n de apuntes por curso y lecci\\xf3n\",\"allNotes\":\"Todos los apuntes\",\"collapse\":\"Contraer\",\"expand\":\"Expandir\",\"toggle\":\"Cursos y lecciones\"},\"card\":{\"aiGenerated\":\"Generado por SofLIA\",\"updatedAt\":\"Actualizado el {{date}}\"},\"preview\":{\"loading\":\"Cargando vista previa...\",\"openHint\":\"Clic para editar\"},\"empty\":{\"title\":\"A\\xfan no tienes apuntes\",\"description\":\"Crea tu primer apunte eligiendo un curso y una lecci\\xf3n, o toma notas desde tus lecciones.\",\"filteredTitle\":\"Sin resultados\",\"filteredDescription\":\"No encontramos apuntes que coincidan con tu b\\xfasqueda o filtro.\",\"aria\":\"No hay apuntes para mostrar\"},\"error\":{\"retry\":\"Reintentar\"},\"compendium\":{\"label\":\"Compendio del curso\",\"badge\":\"Compendio SofLIA\",\"readOnlyHint\":\"Este compendio se compone con tus apuntes del curso. Puedes editarlo libremente; regener\\xe1ralo para reconstruirlo con tus apuntes m\\xe1s recientes (se descartan tus ediciones).\",\"regenerate\":\"Regenerar compendio\",\"regenerating\":\"Regenerando...\",\"regenerateConfirm\":\"\\xbfRegenerar el compendio? Se reconstruir\\xe1 con tus apuntes m\\xe1s recientes y se descartar\\xe1n las ediciones que hayas hecho.\",\"regenerateSuccess\":\"La regeneraci\\xf3n del compendio comenz\\xf3.\",\"regenerateError\":\"No se pudo regenerar el compendio.\",\"exportPdf\":\"Exportar cuaderno en PDF\"},\"newNote\":{\"button\":\"Nuevo apunte\",\"title\":\"Crear nuevo apunte\",\"subtitle\":\"Elige el curso y la lecci\\xf3n del apunte\",\"close\":\"Cerrar\",\"loadingCourses\":\"Cargando cursos...\",\"noCourses\":\"No tienes cursos con lecciones disponibles para crear apuntes.\",\"courseLabel\":\"Curso\",\"coursePlaceholder\":\"Selecciona un curso\",\"lessonLabel\":\"Lecci\\xf3n\",\"lessonPlaceholder\":\"Selecciona una lecci\\xf3n\",\"titleLabel\":\"T\\xedtulo (opcional)\",\"titlePlaceholder\":\"Ej. Conceptos clave\",\"cancel\":\"Cancelar\",\"create\":\"Crear apunte\",\"loadError\":\"No se pudieron cargar los cursos.\",\"createError\":\"No se pudo crear el apunte.\"},\"enrichment\":{\"title\":\"An\\xe1lisis de SofLIA\",\"loading\":\"Cargando an\\xe1lisis...\",\"processing\":\"SofLIA est\\xe1 analizando tu apunte. El resumen aparecer\\xe1 aqu\\xed en unos momentos.\",\"empty\":\"Guarda contenido en tu apunte y SofLIA lo analizar\\xe1 autom\\xe1ticamente.\",\"failed\":\"No se pudo analizar este apunte. El an\\xe1lisis se reintentar\\xe1 al volver a editarlo.\",\"summaryLabel\":\"Resumen\",\"conceptsLabel\":\"Conceptos clave\",\"tasksLabel\":\"Tareas detectadas\",\"aiDisclaimer\":\"Generado por SofLIA a partir de tu apunte. Puede contener imprecisiones.\",\"suggestedBadge\":\"Sugerida\",\"taskConfirm\":\"Confirmar tarea\",\"taskDismiss\":\"Descartar tarea\",\"taskComplete\":\"Marcar como completada\",\"taskReopen\":\"Reabrir tarea\",\"taskActionError\":\"No se pudo actualizar la tarea.\",\"knowledgeType\":{\"note\":\"Apunte\",\"reflection\":\"Reflexi\\xf3n\",\"decision\":\"Decisi\\xf3n\",\"qa\":\"Pregunta y respuesta\",\"resource\":\"Recurso\",\"evidence\":\"Evidencia\"},\"retry\":\"Reintentar an\\xe1lisis\",\"analyzeNow\":\"Analizar ahora\",\"retryError\":\"No se pudo pedir el an\\xe1lisis. Int\\xe9ntalo de nuevo.\"},\"editor\":{\"back\":\"Volver\",\"backToNotebook\":\"Volver al libro de apuntes\",\"loading\":\"Cargando apunte...\",\"notFound\":\"No se encontr\\xf3 la nota o no tienes acceso a ella.\",\"save\":\"Guardar\",\"delete\":\"Eliminar\",\"confirmDelete\":\"Eliminar\",\"confirmDeletePrompt\":\"\\xbfEliminar este apunte? Esta acci\\xf3n no se puede deshacer.\",\"cancel\":\"Cancelar\",\"locationLabel\":\"Ubicaci\\xf3n\",\"actionsLabel\":\"Acciones\",\"titlePlaceholder\":\"T\\xedtulo del apunte\",\"contentPlaceholder\":\"Empieza a escribir tu apunte...\",\"generatedReadOnlyHint\":\"Este apunte conserva la evidencia generada por SofLIA y es de solo lectura. Puedes crear un apunte manual para agregar tus propias reflexiones.\",\"tagsLabel\":\"Etiquetas\",\"tagPlaceholder\":\"Agregar etiqueta\",\"removeTag\":\"Quitar etiqueta {{tag}}\",\"status\":{\"saving\":\"Guardando...\",\"saved\":\"Guardado\",\"error\":\"Error al guardar\"},\"toolbar\":{\"bold\":\"Negrita\",\"italic\":\"Cursiva\",\"underline\":\"Subrayado\",\"strike\":\"Tachado\",\"heading1\":\"T\\xedtulo 1\",\"heading2\":\"T\\xedtulo 2\",\"heading3\":\"T\\xedtulo 3\",\"bulletList\":\"Lista con vi\\xf1etas\",\"orderedList\":\"Lista numerada\",\"blockquote\":\"Cita\",\"inlineCode\":\"C\\xf3digo en l\\xednea\",\"code\":\"Bloque de c\\xf3digo\",\"horizontalRule\":\"L\\xednea horizontal\",\"clearFormat\":\"Limpiar formato\",\"fontFamily\":\"Fuente\",\"fontSize\":\"Tama\\xf1o de letra\",\"fontDefault\":\"Fuente\",\"sizeDefault\":\"Tama\\xf1o\",\"default\":\"Predeterminado\",\"textColor\":\"Color de letra\",\"highlight\":\"Resaltado\",\"removeColor\":\"Quitar color\",\"lineHeight\":\"Interlineado\",\"lineHeightDefault\":\"Interlineado\",\"subscript\":\"Sub\\xedndice\",\"superscript\":\"Super\\xedndice\",\"taskList\":\"Lista de tareas\",\"alignLeft\":\"Alinear a la izquierda\",\"alignCenter\":\"Centrar\",\"alignRight\":\"Alinear a la derecha\",\"link\":\"Insertar enlace\",\"unlink\":\"Quitar enlace\",\"undo\":\"Deshacer\",\"redo\":\"Rehacer\",\"applyLink\":\"Aplicar\",\"cancelLink\":\"Cancelar\",\"increaseFont\":\"Aumentar tama\\xf1o\",\"decreaseFont\":\"Reducir tama\\xf1o\"},\"moreActions\":\"M\\xe1s acciones\"},\"soflia\":{\"chat\":{\"title\":\"Preg\\xfantale a SofLIA\",\"placeholder\":\"SofLIA puede ver este apunte. Preg\\xfantale, o p\\xeddele que lo mejore, resuma o reescriba y aplica su propuesta con un clic.\",\"inputPlaceholder\":\"Escribe tu pregunta…\",\"thinking\":\"SofLIA est\\xe1 pensando…\",\"send\":\"Enviar\",\"errorFallback\":\"SofLIA no pudo responder en este momento.\"},\"edit\":{\"proposalTitle\":\"SofLIA propone una edici\\xf3n\",\"apply\":\"Aplicar\",\"discard\":\"Descartar\",\"applied\":\"Edici\\xf3n aplicada al apunte\",\"dismissed\":\"Propuesta descartada\"}}}'),y=JSON.parse('{\"nav\":{\"homeLabel\":\"Ir al inicio de SofLIA\",\"primaryLabel\":\"Navegaci\\xf3n principal\",\"mobileLabel\":\"Navegaci\\xf3n m\\xf3vil\",\"system\":\"El sistema\",\"method\":\"Metodolog\\xeda\",\"services\":\"Capacidades\",\"clientAccess\":\"Acceso clientes\",\"downloadHub\":\"Descargar Pulse Hub\",\"language\":\"Cambiar idioma\",\"toggleTheme\":\"Cambiar tema\",\"switchToLight\":\"Cambiar a modo claro\",\"switchToDark\":\"Cambiar a modo oscuro\",\"openMenu\":\"Abrir men\\xfa\",\"closeMenu\":\"Cerrar men\\xfa\"},\"hero\":{\"eyebrow\":\"Sistema de evoluci\\xf3n del talento\",\"titleStart\":\"Evoluciona tu talento\",\"titleHighlight\":\"al ritmo de la tecnolog\\xeda.\",\"description\":\"SofLIA garantiza la relevancia de tu equipo en la era de la IA mediante un sistema de adopci\\xf3n dise\\xf1ado para el upskilling y reskilling organizacional medible.\",\"primaryCta\":\"Agenda un diagn\\xf3stico de adopci\\xf3n\",\"secondaryCta\":\"Conoce el sistema SofLIA\",\"stagesLabel\":\"Etapas clave del sistema SofLIA\",\"stages\":{\"diagnosis\":\"Diagn\\xf3stico\",\"adoption\":\"Adopci\\xf3n\",\"impact\":\"Impacto medible\"},\"logoAlt\":\"Logotipo 3D de SofLIA\"},\"showcase\":{\"eyebrow\":\"SofLIA en acci\\xf3n\",\"title\":\"La evoluci\\xf3n se entiende mejor cuando se ve.\",\"description\":\"Conoce c\\xf3mo convertimos aprendizaje, pr\\xe1ctica y acompa\\xf1amiento en capacidades que llegan al trabajo real.\",\"closingKicker\":\"De la intenci\\xf3n a la aplicaci\\xf3n\",\"closingTitle\":\"Aprender es el inicio. Evolucionar es convertirlo en capacidad.\",\"pauseVideo\":\"Pausar video de presentaci\\xf3n\",\"playVideo\":\"Reproducir video de presentaci\\xf3n\",\"pauseVideoShort\":\"Pausar\",\"playVideoShort\":\"Reproducir\"},\"narrative\":{\"eyebrow\":\"La brecha\",\"navigationLabel\":\"Navegaci\\xf3n de la historia\",\"goToSlide\":\"Ir a la etapa {{number}}\",\"slides\":[{\"kicker\":\"01 \\xb7 El riesgo\",\"title\":\"La brecha de habilidades ya est\\xe1 creciendo.\",\"description\":\"La tecnolog\\xeda avanza m\\xe1s r\\xe1pido que la capacidad de los equipos para convertirla en una forma nueva y relevante de trabajar.\",\"points\":[\"Obsolescencia acelerada de las habilidades actuales.\",\"Incertidumbre sobre c\\xf3mo mantener la relevancia del equipo.\"]},{\"kicker\":\"02 \\xb7 La fricci\\xf3n\",\"title\":\"Hay pilotos. Falta un sistema.\",\"description\":\"La experimentaci\\xf3n aislada genera entusiasmo, pero no crea adopci\\xf3n sostenible ni transforma la operaci\\xf3n diaria.\",\"points\":[\"Falta un m\\xe9todo para cerrar la brecha de capacidades.\",\"Hay entusiasmo, pero falta escalamiento y medici\\xf3n.\"]},{\"kicker\":\"03 \\xb7 La respuesta\",\"title\":\"Arquitectura de capacidades, no capacitaci\\xf3n aislada.\",\"description\":\"Implementamos una arquitectura que utiliza la IA como habilitador estrat\\xe9gico para evolucionar habilidades, decisiones y formas de operar.\",\"points\":[\"Upskilling conectado con prioridades reales del negocio.\",\"Reskilling personalizado para mantener la relevancia del talento.\"]},{\"kicker\":\"04 \\xb7 El resultado\",\"title\":\"Evoluci\\xf3n constante. Impacto visible.\",\"description\":\"SofLIA conecta diagn\\xf3stico, aprendizaje, pr\\xe1ctica, acompa\\xf1amiento y medici\\xf3n en un solo sistema de evoluci\\xf3n organizacional.\",\"points\":[\"Casos de uso concretos aplicados al trabajo diario.\",\"Cierre medible y continuo de la brecha de habilidades.\"]}]},\"ecosystem\":{\"eyebrow\":\"Ecosistema SofLIA\",\"title\":\"Aprender, aplicar y medir en un mismo sistema.\",\"description\":\"Cuatro componentes coordinados convierten la evoluci\\xf3n del talento en una capacidad permanente de la organizaci\\xf3n.\",\"selectItem\":\"Explorar {{name}}\",\"poweredBy\":\"Powered by SofLIA\",\"brand\":\"SofLIA\",\"defaultRole\":\"Ecosistema\",\"selectHint\":\"Selecciona una herramienta para conocer su rol dentro del ecosistema.\",\"items\":[{\"id\":\"engine\",\"name\":\"SofLIA Engine\",\"role\":\"Inteligencia y orquestaci\\xf3n\",\"description\":\"Integra contexto, diagn\\xf3stico y se\\xf1ales de avance para convertir prioridades estrat\\xe9gicas en rutas de evoluci\\xf3n accionables.\"},{\"id\":\"learning\",\"name\":\"SofLIA Learning\",\"role\":\"Aprendizaje aplicado\",\"description\":\"Despliega experiencias de aprendizaje, pr\\xe1ctica guiada y rutas personalizadas conectadas con el trabajo real.\"},{\"id\":\"agent\",\"name\":\"Pulse-Hub\",\"role\":\"Acompa\\xf1amiento continuo\",\"description\":\"Acompa\\xf1a a cada persona durante la aplicaci\\xf3n, responde en contexto y ayuda a convertir conocimiento en desempe\\xf1o.\"},{\"id\":\"skills\",\"name\":\"SofLIA Skills\",\"role\":\"Capacidades reutilizables\",\"description\":\"Re\\xfane playbooks, pr\\xe1cticas y capacidades aplicadas para acelerar la adopci\\xf3n y conservar el conocimiento organizacional.\"}],\"messageStart\":\"La tecnolog\\xeda es el habilitador;\",\"messageHighlight\":\"el resultado es cerrar de forma permanente la brecha de capacidades.\"},\"services\":{\"eyebrow\":\"Capacidades\",\"title\":\"Todo lo necesario para pasar de intenci\\xf3n a adopci\\xf3n.\",\"description\":\"Intervenciones modulares que pueden iniciar con un diagn\\xf3stico y escalar hasta un sistema enterprise de evoluci\\xf3n continua.\",\"dragHint\":\"Arrastra para explorar\",\"previous\":\"Ver capacidad anterior\",\"next\":\"Ver capacidad siguiente\",\"listLabel\":\"Capacidades y servicios de SofLIA\",\"items\":[{\"id\":\"diagnosis\",\"title\":\"Diagn\\xf3stico de madurez en IA\",\"description\":\"Identificamos brechas, riesgos, oportunidades y prioridades de evoluci\\xf3n por rol, \\xe1rea y operaci\\xf3n.\",\"outcome\":\"Roadmap priorizado\"},{\"id\":\"adoption\",\"title\":\"Programas de adopci\\xf3n\",\"description\":\"Dise\\xf1amos programas que conectan liderazgo, capacidades, pr\\xe1ctica y gesti\\xf3n del cambio.\",\"outcome\":\"Adopci\\xf3n sostenible\"},{\"id\":\"ai-first\",\"title\":\"Capacitaci\\xf3n AI-First\",\"description\":\"Desarrollamos habilidades estrat\\xe9gicas, operativas y funcionales para trabajar con IA de forma relevante.\",\"outcome\":\"Talento vigente\"},{\"id\":\"production\",\"title\":\"Producci\\xf3n de aprendizaje\",\"description\":\"Creamos cursos, rutas, actividades y recursos instruccionales para SofLIA o el LMS del cliente.\",\"outcome\":\"Contenido aplicable\"},{\"id\":\"learning\",\"title\":\"Despliegue en SofLIA Learning\",\"description\":\"Activamos rutas personalizadas, seguimiento, pr\\xe1ctica y medici\\xf3n dentro del entorno SofLIA.\",\"outcome\":\"Ejecuci\\xf3n a escala\"},{\"id\":\"agent\",\"title\":\"Acompa\\xf1amiento con SofLIA Agent\",\"description\":\"Extendemos el aprendizaje al flujo de trabajo con orientaci\\xf3n contextual y soporte continuo.\",\"outcome\":\"Transferencia operativa\"},{\"id\":\"playbooks\",\"title\":\"Playbooks y SofLIA Skills\",\"description\":\"Convertimos mejores pr\\xe1cticas y casos de uso en capacidades reutilizables por toda la organizaci\\xf3n.\",\"outcome\":\"Conocimiento vivo\"},{\"id\":\"consulting\",\"title\":\"Consultor\\xeda de casos de uso\",\"description\":\"Priorizamos oportunidades y dise\\xf1amos formas seguras y medibles de aplicar IA en procesos clave.\",\"outcome\":\"Impacto de negocio\"}]},\"method\":{\"eyebrow\":\"Metodolog\\xeda SofLIA\",\"title\":\"Del diagn\\xf3stico al escalamiento.\",\"description\":\"Un ciclo completo que alinea la evoluci\\xf3n del talento con el desempe\\xf1o, la relevancia y los objetivos de negocio.\",\"formulaLead\":\"Diagn\\xf3stico + pr\\xe1ctica + acompa\\xf1amiento + medici\\xf3n\",\"formulaResult\":\"Evoluci\\xf3n organizacional medible\",\"phases\":[{\"name\":\"Diagn\\xf3stico\",\"description\":\"Mapeamos la brecha de habilidades y la madurez actual.\",\"points\":[\"Mapa de brecha de habilidades por rol y \\xe1rea.\",\"Evaluaci\\xf3n de madurez en IA y casos de uso potenciales.\"],\"outcome\":\"Entrega: roadmap priorizado\"},{\"name\":\"Priorizaci\\xf3n\",\"description\":\"Conectamos capacidades con retos y oportunidades de negocio.\",\"points\":[\"Selecci\\xf3n de capacidades con mayor impacto en el negocio.\",\"Definici\\xf3n de m\\xe9tricas y l\\xednea base por iniciativa.\"],\"outcome\":\"Entrega: plan de evoluci\\xf3n\"},{\"name\":\"Dise\\xf1o\",\"description\":\"Construimos la arquitectura y las rutas de evoluci\\xf3n.\",\"points\":[\"Arquitectura de capacidades y rutas por perfil.\",\"Experiencias, actividades y recursos instruccionales.\"],\"outcome\":\"Entrega: rutas de evoluci\\xf3n\"},{\"name\":\"Capacitaci\\xf3n\",\"description\":\"Desarrollamos conocimiento relevante y contextual.\",\"points\":[\"Programas AI-First por nivel estrat\\xe9gico, operativo y funcional.\",\"Aprendizaje contextual conectado al trabajo real.\"],\"outcome\":\"Resultado: conocimiento aplicable\"},{\"name\":\"Pr\\xe1ctica\",\"description\":\"Aplicamos lo aprendido en situaciones reales de trabajo.\",\"points\":[\"Casos de uso reales guiados dentro de la operaci\\xf3n.\",\"Retos y simulaciones con acompa\\xf1amiento de SofLIA.\"],\"outcome\":\"Resultado: transferencia operativa\"},{\"name\":\"Acompa\\xf1amiento\",\"description\":\"Sostenemos el cambio con gu\\xeda humana y asistencia de IA.\",\"points\":[\"Gu\\xeda humana y asistencia de IA en el flujo de trabajo.\",\"Resoluci\\xf3n contextual de dudas y refuerzo continuo.\"],\"outcome\":\"Resultado: adopci\\xf3n sostenida\"},{\"name\":\"Medici\\xf3n\",\"description\":\"Observamos relevancia, adopci\\xf3n y desempe\\xf1o.\",\"points\":[\"Tablero de relevancia, adopci\\xf3n y desempe\\xf1o.\",\"Evidencia del cierre de brecha por equipo y capacidad.\"],\"outcome\":\"Entrega: m\\xe9tricas de impacto\"},{\"name\":\"Optimizaci\\xf3n\",\"description\":\"Ajustamos rutas e intervenciones con evidencia.\",\"points\":[\"Ajuste de rutas e intervenciones con base en evidencia.\",\"Iteraci\\xf3n sobre los casos de uso de mayor retorno.\"],\"outcome\":\"Resultado: mejora continua\"},{\"name\":\"Escalamiento\",\"description\":\"Extendemos capacidades probadas a toda la organizaci\\xf3n.\",\"points\":[\"Extensi\\xf3n de capacidades probadas a toda la organizaci\\xf3n.\",\"Playbooks y est\\xe1ndares reutilizables con SofLIA Skills.\"],\"outcome\":\"Resultado: evoluci\\xf3n permanente\"}]},\"radar\":{\"eyebrow\":\"Radar de capacidades\",\"title\":\"La brecha, medida. La evoluci\\xf3n, visible.\",\"description\":\"Un mismo equipo, dos perfiles de capacidad: el punto de partida y el resultado tras operar con el sistema SofLIA.\",\"chartLabel\":\"Radar comparativo de capacidades: hoy frente a con SofLIA\",\"legendLabel\":\"Series del radar\",\"tableAxis\":\"Capacidad\",\"series\":{\"now\":\"Hoy\",\"soflia\":\"Con SofLIA\"},\"axes\":{\"strategy\":\"Estrategia IA\",\"adoption\":\"Adopci\\xf3n\",\"productivity\":\"Productividad\",\"skills\":\"Habilidades\",\"measurement\":\"Medici\\xf3n\",\"culture\":\"Cultura\"},\"note\":\"Perfil ilustrativo sobre una escala de capacidad 0–100, construido a partir del diagn\\xf3stico y la medici\\xf3n continua del sistema.\"},\"impact\":{\"eyebrow\":\"Relevancia organizacional\",\"title\":\"Una evoluci\\xf3n que conecta a toda la empresa.\",\"description\":\"SofLIA alinea a quienes definen la estrategia con quienes convierten la IA en desempe\\xf1o cotidiano.\",\"audienceLabel\":\"Dise\\xf1ado para\",\"benefitsLabel\":\"Impacto esperado\",\"networkLabel\":\"Red de \\xe1reas conectadas por el sistema SofLIA\",\"stageLabel\":\"Se\\xf1al de impacto\",\"progressLabel\":\"Progreso de las se\\xf1ales de impacto\",\"audiences\":[\"Direcci\\xf3n General\",\"Recursos Humanos\",\"Capacitaci\\xf3n\",\"Transformaci\\xf3n Digital\",\"Tecnolog\\xeda\",\"Innovaci\\xf3n\",\"Ventas\",\"Operaciones\"],\"benefits\":[{\"title\":\"Talento relevante\",\"description\":\"Reduce el riesgo de obsolescencia y fortalece la vigencia de las capacidades.\"},{\"title\":\"Brecha visible\",\"description\":\"Hace medible el cierre del skill gap y orienta la siguiente decisi\\xf3n.\"},{\"title\":\"Adopci\\xf3n real\",\"description\":\"Acelera la pr\\xe1ctica, reduce resistencia y lleva la IA a casos de uso concretos.\"},{\"title\":\"Impacto demostrable\",\"description\":\"Conecta evoluci\\xf3n, tiempo, desempe\\xf1o y m\\xe9tricas relevantes para el negocio.\"}]},\"packages\":{\"eyebrow\":\"Rutas de entrada\",\"title\":\"Empieza donde est\\xe1s. Escala hasta donde necesitas.\",\"description\":\"Cada modalidad construye evidencia para avanzar al siguiente nivel sin imponer una transformaci\\xf3n sobredimensionada.\",\"tabsLabel\":\"Paquetes de evoluci\\xf3n SofLIA\",\"cta\":\"Explorar esta ruta\",\"stageLabel\":\"Nivel de evoluci\\xf3n\",\"progressLabel\":\"Progreso de la ruta de evoluci\\xf3n\",\"previous\":\"Ver nivel anterior\",\"next\":\"Ver siguiente nivel\",\"items\":[{\"id\":\"diagnosis\",\"name\":\"Diagn\\xf3stico\",\"scope\":\"Punto de partida\",\"description\":\"Una lectura ejecutiva de brechas, madurez y oportunidades para construir un roadmap de evoluci\\xf3n del talento.\"},{\"id\":\"pilot\",\"name\":\"Piloto\",\"scope\":\"Prueba enfocada\",\"description\":\"Una intervenci\\xf3n acotada para validar adopci\\xf3n, aprendizaje aplicado y m\\xe9tricas antes de escalar.\"},{\"id\":\"basic\",\"name\":\"Programa b\\xe1sico\",\"scope\":\"Capacidad inicial\",\"description\":\"Desarrollo de capacidades prioritarias para un equipo o reto concreto con pr\\xe1ctica y seguimiento.\"},{\"id\":\"intermediate\",\"name\":\"Programa intermedio\",\"scope\":\"Adopci\\xf3n por \\xe1rea\",\"description\":\"Arquitectura de capacidades, rutas y acompa\\xf1amiento para transformar una funci\\xf3n completa.\"},{\"id\":\"premium\",\"name\":\"Programa premium\",\"scope\":\"Transformaci\\xf3n integral\",\"description\":\"Evoluci\\xf3n coordinada de liderazgo, talento y operaci\\xf3n con medici\\xf3n continua del impacto.\"},{\"id\":\"enterprise\",\"name\":\"Enterprise\",\"scope\":\"Evoluci\\xf3n continua\",\"description\":\"Un sistema permanente de upskilling y reskilling para mantener la relevancia de toda la organizaci\\xf3n.\"}]},\"final\":{\"eyebrow\":\"El siguiente movimiento\",\"title\":