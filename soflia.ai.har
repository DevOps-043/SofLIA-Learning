"compat\":\"Ubuntu 20.04+ / Debian 11+ (64-bit)\"}}},\"features\":{\"eyebrow\":\"Qu\\xe9 incluye\",\"title\":\"Un hub que trabaja contigo.\",\"description\":\"Seis capacidades que convierten tu escritorio en un espacio de operaciones inteligente.\",\"items\":[{\"title\":\"Tu asistente personal de IA\",\"description\":\"LIA se convierte en tu asistente en el escritorio: automatiza flujos, investiga a fondo y responde al instante.\"},{\"title\":\"Ecosistema completo\",\"description\":\"Interact\\xfaa con todo el ecosistema SofLIA y comparte chats, proyectos, carpetas y prompts con tu equipo.\"},{\"title\":\"Integraciones potentes\",\"description\":\"Conexi\\xf3n fluida con WhatsApp, Google Workspace y Microsoft 365, todo centralizado en un solo lugar.\"},{\"title\":\"Control de tu computadora\",\"description\":\"Busca dentro de tus archivos locales y ejecuta comandos del sistema de forma inteligente y segura.\"},{\"title\":\"\\xc1rea de productividad\",\"description\":\"Monitorea tu actividad, optimiza tu tiempo de concentraci\\xf3n y gestiona tus tareas diarias.\"},{\"title\":\"Configuraci\\xf3n profunda\",\"description\":\"Personaliza la interacci\\xf3n, gestiona integraciones y decide exactamente c\\xf3mo trabaja SofLIA para ti.\"}]},\"steps\":{\"eyebrow\":\"En tres pasos\",\"title\":\"De la descarga al flujo diario.\",\"items\":[{\"title\":\"Descarga\",\"description\":\"Elige tu plataforma y descarga el instalador oficial.\"},{\"title\":\"Instalaci\\xf3n\",\"description\":\"Ejecuta el asistente y sigue los pasos en pantalla.\"},{\"title\":\"Sincronizaci\\xf3n\",\"description\":\"Inicia sesi\\xf3n y disfruta de Pulse Hub en tu flujo diario.\"}]},\"safety\":{\"official\":\"Instalador oficial y firmado\",\"source\":\"Distribuido desde nuestro repositorio verificado\",\"updates\":\"Actualizaciones autom\\xe1ticas integradas\"},\"changelog\":{\"title\":\"Novedades de Pulse Hub\",\"subtitle\":\"Historial de versiones y mejoras.\",\"close\":\"Cerrar\",\"empty\":\"Sin his